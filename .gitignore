# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
out/
.turbo/

# Env
.env
.env.local
.env.*.local
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Coverage
coverage/
*.lcov

# Prisma
apps/api/prisma/migrations/dev/
prisma/.db.sqlite

# Flutter (if added later)
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
ios/Pods/
android/.gradle/
android/app/release/

# Claude Code — local permissions and lock files; machine-specific, never commit
.claude/

# Misc
*.tsbuildinfo
.eslintcache

# Playwright (E2E artifacts)
test-results/
playwright-report/
playwright/.cache/
.last-run.json

# Playwright storage-state (Phase 7E) — JWT tokens; never commit
**/e2e/.auth/

# Database backups — contain sensitive customer data, never commit
backups/
*.dump
*.pgdump

# Mobile Firebase / APNs credentials — real files live next to the .example stubs
apps/mobile/**/google-services.json
apps/mobile/**/GoogleService-Info.plist
!apps/mobile/**/*.example

# Security credentials — never commit key material
*.pem
*.key
*service-account*.json
*.p12

# Local dev utilities that write to ~/Desktop — useful locally, not for CI
apps/api/scripts/gen-test-xlsx.ts

# Written by `next dev` (Next 16) on every run — not project content.
apps/web-admin/AGENTS.md
apps/web-public/AGENTS.md
