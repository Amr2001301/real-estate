{
  "name": "real-estate-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @rep/api prisma:generate",
    "db:migrate": "pnpm --filter @rep/api prisma:migrate",
    "db:deploy": "pnpm --filter @rep/api prisma:deploy",
    "db:status": "pnpm --filter @rep/api exec prisma migrate status",
    "db:schema-check": "pnpm --filter @rep/api prisma:schema-check",
    "db:seed": "pnpm --filter @rep/api prisma:seed",
    "db:seed:full-demo": "pnpm --filter @rep/api prisma:seed:full-demo",
    "db:studio": "pnpm --filter @rep/api prisma:studio",
    "db:backup": "DATABASE_URL=\"${DATABASE_URL:?}\" ./scripts/db-backup.sh",
    "db:restore:test": "DUMP_FILE=\"${DUMP_FILE:?}\" TARGET_DATABASE_URL=\"${TARGET_DATABASE_URL:?}\" ./scripts/db-restore-test.sh"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": "22.23.2",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "@fastify/busboy@>=3 <3.2.1": "3.2.1",
      "@grpc/grpc-js@>=1 <1.14.5": "1.14.5",
      "body-parser@>=1 <1.20.9": "1.20.9",
      "brace-expansion@>=1 <1.1.20": "1.1.20",
      "brace-expansion@>=2 <2.1.6": "2.1.6",
      "brace-expansion@>=5 <5.0.11": "5.0.11",
      "browserslist@>=4 <4.28.7": "4.28.7",
      "dompurify@>=3 <3.4.17": "3.4.17",
      "fast-uri@>=3 <3.1.7": "3.1.7",
      "form-data@>=2 <2.5.6": "2.5.6",
      "js-yaml@>=4 <4.3.2": "4.3.2",
      "lodash@>=4 <4.18.0": "4.18.0",
      "multer@>=2 <2.5.0": "2.5.0",
      "nanoid@>=3 <3.3.18": "3.3.18",
      "postcss@>=8 <8.5.18": "8.5.18",
      "prosemirror-view@>=1 <1.42.3": "1.42.3",
      "protobufjs@>=7 <7.6.1": "7.6.1",
      "proxy-addr@>=2 <2.0.8": "2.0.8",
      "source-map-js@>=1 <1.2.2": "1.2.2",
      "undici@>=8 <8.12.2": "8.12.2",
      "websocket-driver@<0.7.5": "0.7.5"
    }
  }
}
