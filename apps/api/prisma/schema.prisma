// Real Estate Platform — Prisma schema
// Translatable fields are stored as Json: { ar: string, en: string }

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// AUTH & USERS
// =============================================================================

enum UserRole {
  ADMIN
  SALES
  CLIENT
  CUSTOMER
  BROKER
}

enum Locale {
  ar
  en
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  role         UserRole
  email        String?   @unique
  phone        String?   @unique
  passwordHash String?
  fullName     String
  locale       Locale    @default(ar)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  refreshTokens           RefreshToken[]
  rolePermissions         UserPermission[]
  deviceTokens            DeviceToken[]
  notifications           Notification[]
  favorites               Favorite[]
  visitRequests           VisitRequest[]            @relation("VisitRequestUser")
  infoRequests            InfoRequest[]             @relation("InfoRequestUser")
  assignedLeads           Lead[]                    @relation("LeadAssignedSales")
  leads                   Lead[]                    @relation("LeadClient")
  leadNotes               LeadNote[]
  reservations            Reservation[]             @relation("ReservationSales")
  reservationClients      Reservation[]             @relation("ReservationClient")
  reservationNotes        ReservationNote[]         @relation("ReservationNoteAuthor")
  reservationActivities   ReservationActivity[]     @relation("ReservationActivityActor")
  customerContracts       Contract[]                @relation("ContractCustomer")
  bonusEntries            BonusEntry[]
  salesTargets            SalesTarget[]
  maintenanceReqs         MaintenanceRequest[]      @relation("MaintenanceCustomer")
  maintenanceAssigned     MaintenanceRequest[]      @relation("MaintenanceAdmin")
  recordedDeposits        Deposit[]                 @relation("DepositRecordedBy")
  auditLogs               AuditLog[]
  unitStatusChanges       UnitStatusHistory[]
  visitsScheduledForSales VisitRequest[]            @relation("VisitRequestSales")
  assignedAppointments    VisitAppointment[]        @relation("AppointmentSales")
  createdAppointments     VisitAppointment[]        @relation("AppointmentCreator")
  updatedAppointments     VisitAppointment[]        @relation("AppointmentUpdater")
  clientAppointments      VisitAppointment[]        @relation("AppointmentClient")
  actedVisitActivities    VisitActivity[]           @relation("VisitActivityActor")
  clientVisitActivities   VisitActivity[]           @relation("VisitActivityClient")
  planTemplatesCreated    InstallmentPlanTemplate[] @relation("PlanTemplateCreator")

  // ── Broker relations (additive) ──────────────────────────────────────────
  brokerProfile           BrokerUser?
  brokersOnboarded        Broker[]                  @relation("BrokerCreatedBy")
  brokerLeads             Lead[]                    @relation("LeadBrokerAgent")
  brokerReservations      Reservation[]             @relation("ReservationBrokerAgent")
  brokerContracts         Contract[]                @relation("ContractBrokerAgent")
  brokerVisitRequests     VisitRequest[]            @relation("VisitRequestBrokerAgent")
  brokerAppointments      VisitAppointment[]        @relation("AppointmentBrokerAgent")
  brokerCommissionsAsAgent    BrokerCommission[]    @relation("BrokerCommissionAgent")
  brokerCommissionsApproved   BrokerCommission[]    @relation("BrokerCommissionApprovedBy")
  brokerCommissionsRejected   BrokerCommission[]    @relation("BrokerCommissionRejectedBy")
  brokerPayoutsApproved       BrokerPayout[]        @relation("BrokerPayoutApprovedBy")
  brokerPayoutsProcessed      BrokerPayout[]        @relation("BrokerPayoutProcessedBy")
  brokerPayoutsCancelled      BrokerPayout[]        @relation("BrokerPayoutCancelledBy")
  brokerActivityLogs          BrokerActivityLog[]   @relation("BrokerActivityLogAgent")

  @@index([role])
  @@index([phone])
  @@index([email])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  deviceId  String?
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model OtpCode {
  id        String   @id @default(uuid()) @db.Uuid
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, consumed])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique // e.g. "projects:create"
  description String?
  users       UserPermission[]
}

model UserPermission {
  userId       String     @db.Uuid
  permissionId String     @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String // "ios" | "android" | "web"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// =============================================================================
// PROJECTS, PHASES, BUILDINGS, UNITS
// =============================================================================

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum UnitStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum MediaType {
  IMAGE
  VIDEO
  FLOORPLAN
  DOCUMENT
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  name        Json // Translatable { ar, en }
  description Json
  city        String
  lat         Float
  lng         Float
  status      ProjectStatus @default(DRAFT)
  featured    Boolean       @default(false)
  services    Json          @default("[]") // Translatable[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  media         ProjectMedia[]
  phases        Phase[]
  leads         Lead[]
  visitRequests VisitRequest[]
  infoRequests  InfoRequest[]
  favorites     Favorite[]
  appointments  VisitAppointment[]
  planTemplates InstallmentPlanTemplate[] @relation("ProjectPlanTemplates")
  brokerAccess  BrokerProjectAccess[]
  brokerCommissions BrokerCommission[]

  @@index([city])
  @@index([status, featured])
}

model ProjectMedia {
  id        String    @id @default(uuid()) @db.Uuid
  projectId String    @db.Uuid
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  type      MediaType @default(IMAGE)
  order     Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([projectId, order])
}

model Phase {
  id        String     @id @default(uuid()) @db.Uuid
  projectId String     @db.Uuid
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      Json // Translatable
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  buildings Building[]

  @@index([projectId])
}

model Building {
  id          String   @id @default(uuid()) @db.Uuid
  phaseId     String   @db.Uuid
  phase       Phase    @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  name        String
  totalFloors Int      @default(1)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  units       Unit[]

  @@index([phaseId])
}

model Unit {
  id                   String     @id @default(uuid()) @db.Uuid
  buildingId           String     @db.Uuid
  building             Building   @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  code                 String
  type                 String // studio | 1BR | 2BR | villa | ...
  area                 Float
  bedrooms             Int        @default(0)
  bathrooms            Int        @default(0)
  floor                Int        @default(0)
  price                Decimal    @db.Decimal(14, 2)
  status               UnitStatus @default(AVAILABLE)
  reservationExpiresAt DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  media               UnitMedia[]
  history             UnitStatusHistory[]
  reservations        Reservation[]
  contracts           Contract[]
  visitRequests       VisitRequest[]
  infoRequests        InfoRequest[]
  favorites           Favorite[]
  maintenanceRequests MaintenanceRequest[]
  appointments        VisitAppointment[]
  leadsInterested     Lead[]                    @relation("LeadUnitInterest")
  planTemplates       InstallmentPlanTemplate[] @relation("UnitPlanTemplates")
  brokerAccess        BrokerUnitAccess[]
  brokerCommissions   BrokerCommission[]

  @@unique([buildingId, code])
  @@index([status])
  @@index([price])
}

model UnitMedia {
  id        String    @id @default(uuid()) @db.Uuid
  unitId    String    @db.Uuid
  unit      Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  url       String
  type      MediaType @default(IMAGE)
  order     Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([unitId, order])
}

model UnitStatusHistory {
  id          String     @id @default(uuid()) @db.Uuid
  unitId      String     @db.Uuid
  unit        Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  oldStatus   UnitStatus
  newStatus   UnitStatus
  changedById String?    @db.Uuid
  changedBy   User?      @relation(fields: [changedById], references: [id])
  reason      String?
  changedAt   DateTime   @default(now())

  @@index([unitId, changedAt])
}

// =============================================================================
// CRM
// =============================================================================

enum LeadStage {
  NEW
  INTERESTED
  VISIT
  NEGOTIATION
  WON
  LOST
}

model LeadSource {
  id        String   @id @default(uuid()) @db.Uuid
  name      Json // Translatable
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  leads     Lead[]
}

model Lead {
  id                String      @id @default(uuid()) @db.Uuid
  // Canonical contact lives on the linked Client (User). The denormalized
  // fullName/phone/email below are kept for safe backfill and as a cache for
  // legacy readers; new code should prefer `client.*`.
  clientId          String      @db.Uuid
  client            User        @relation("LeadClient", fields: [clientId], references: [id])
  fullName          String
  phone             String
  email             String?
  sourceId          String?     @db.Uuid
  source            LeadSource? @relation(fields: [sourceId], references: [id])
  projectInterestId String?     @db.Uuid
  projectInterest   Project?    @relation(fields: [projectInterestId], references: [id])
  unitInterestId    String?     @db.Uuid
  unitInterest      Unit?       @relation("LeadUnitInterest", fields: [unitInterestId], references: [id])
  assignedSalesId   String?     @db.Uuid
  assignedSales     User?       @relation("LeadAssignedSales", fields: [assignedSalesId], references: [id])
  stage             LeadStage   @default(NEW)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // ── Broker attribution (additive, all nullable) ─────────────────────────
  brokerId              String?            @db.Uuid
  broker                Broker?            @relation(fields: [brokerId], references: [id])
  brokerAgentId         String?            @db.Uuid
  brokerAgent           User?              @relation("LeadBrokerAgent", fields: [brokerAgentId], references: [id])
  brokerSubmittedAt     DateTime?
  brokerApprovalStatus  BrokerLeadStatus?
  brokerApprovedAt      DateTime?
  brokerRejectedAt      DateTime?
  brokerRejectionReason String?

  notes           LeadNote[]
  activities      LeadActivity[]
  reservations    Reservation[]
  visitRequests   VisitRequest[]
  infoRequests    InfoRequest[]
  appointments    VisitAppointment[]
  visitActivities VisitActivity[]

  @@index([clientId])
  @@index([assignedSalesId])
  @@index([stage])
  @@index([phone])
  @@index([unitInterestId])
  @@index([brokerId])
  @@index([brokerAgentId])
  @@index([brokerApprovalStatus])
}

model LeadNote {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @db.Uuid
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  salesId   String   @db.Uuid
  sales     User     @relation(fields: [salesId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model LeadActivity {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @db.Uuid
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String // call | email | status_change | visit | note | reservation
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

// =============================================================================
// REQUESTS / VISITS / FAVORITES
// =============================================================================

enum VisitStatus {
  PENDING
  APPROVED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum VisitRequestStatus {
  NEW
  UNDER_REVIEW
  CONVERTED
  REJECTED
  CANCELLED
}

enum VisitRequestSource {
  WEBSITE
  MOBILE_APP
  SALES
  PHONE
  WHATSAPP
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum VisitActivityType {
  REQUEST_CREATED
  REQUEST_REVIEWED
  REQUEST_REJECTED
  REQUEST_CANCELLED
  VISIT_SCHEDULED
  VISIT_CONFIRMED
  VISIT_COMPLETED
  VISIT_CANCELLED
  VISIT_NO_SHOW
  VISIT_RESCHEDULED
  SALES_ASSIGNED
  NOTE_ADDED
}

model InfoRequest {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation("InfoRequestUser", fields: [userId], references: [id])
  leadId    String?  @db.Uuid
  lead      Lead?    @relation(fields: [leadId], references: [id])
  projectId String?  @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id])
  unitId    String?  @db.Uuid
  unit      Unit?    @relation(fields: [unitId], references: [id])
  message   String
  status    String   @default("OPEN") // OPEN | RESPONDED | CLOSED
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([userId])
}

model VisitRequest {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String?     @db.Uuid
  user            User?       @relation("VisitRequestUser", fields: [userId], references: [id])
  leadId          String?     @db.Uuid
  lead            Lead?       @relation(fields: [leadId], references: [id])
  projectId       String      @db.Uuid
  project         Project     @relation(fields: [projectId], references: [id])
  unitId          String?     @db.Uuid
  unit            Unit?       @relation(fields: [unitId], references: [id])
  preferredDate   DateTime
  scheduledAt     DateTime?
  status          VisitStatus @default(PENDING)
  assignedSalesId String?     @db.Uuid
  assignedSales   User?       @relation("VisitRequestSales", fields: [assignedSalesId], references: [id])
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // v2 fields — additive, all nullable, coexist with legacy columns above
  requestNumber          String?             @unique
  customerName           String?
  customerPhone          String?
  customerEmail          String?
  preferredTime          String?
  preferredContactMethod String?
  source                 VisitRequestSource?
  requestNotes           String?
  adminNotes             String?
  requestStatus          VisitRequestStatus?
  convertedAt            DateTime?
  rejectedAt             DateTime?
  cancelledAt            DateTime?

  // ── Broker attribution (additive, all nullable) ─────────────────────────
  brokerId      String? @db.Uuid
  broker        Broker? @relation(fields: [brokerId], references: [id])
  brokerAgentId String? @db.Uuid
  brokerAgent   User?   @relation("VisitRequestBrokerAgent", fields: [brokerAgentId], references: [id])

  appointments    VisitAppointment[]
  visitActivities VisitActivity[]

  @@index([status])
  @@index([requestStatus])
  @@index([projectId])
  @@index([assignedSalesId])
  @@index([brokerId])
  @@index([brokerAgentId])
}

model VisitAppointment {
  id                 String            @id @default(uuid()) @db.Uuid
  visitNumber        String            @unique
  visitRequestId     String?           @db.Uuid
  visitRequest       VisitRequest?     @relation(fields: [visitRequestId], references: [id])
  leadId             String?           @db.Uuid
  lead               Lead?             @relation(fields: [leadId], references: [id])
  clientId           String?           @db.Uuid
  client             User?             @relation("AppointmentClient", fields: [clientId], references: [id])
  projectId          String?           @db.Uuid
  project            Project?          @relation(fields: [projectId], references: [id])
  unitId             String?           @db.Uuid
  unit               Unit?             @relation(fields: [unitId], references: [id])
  assignedSalesId    String?           @db.Uuid
  assignedSales      User?             @relation("AppointmentSales", fields: [assignedSalesId], references: [id])
  scheduledAt        DateTime
  durationMinutes    Int?
  location           String?
  meetingPoint       String?
  status             AppointmentStatus @default(SCHEDULED)
  salesNotes         String?
  customerFeedback   String?
  resultNotes        String?
  cancellationReason String?
  noShowReason       String?
  createdById        String?           @db.Uuid
  createdBy          User?             @relation("AppointmentCreator", fields: [createdById], references: [id])
  updatedById        String?           @db.Uuid
  updatedBy          User?             @relation("AppointmentUpdater", fields: [updatedById], references: [id])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  confirmedAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  noShowAt           DateTime?

  // ── Broker attribution (additive, all nullable) ─────────────────────────
  brokerId      String? @db.Uuid
  broker        Broker? @relation(fields: [brokerId], references: [id])
  brokerAgentId String? @db.Uuid
  brokerAgent   User?   @relation("AppointmentBrokerAgent", fields: [brokerAgentId], references: [id])

  visitActivities VisitActivity[]

  @@index([status])
  @@index([scheduledAt])
  @@index([visitRequestId])
  @@index([assignedSalesId])
  @@index([leadId])
  @@index([clientId])
  @@index([brokerId])
  @@index([brokerAgentId])
}

model VisitActivity {
  id             String            @id @default(uuid()) @db.Uuid
  visitRequestId String?           @db.Uuid
  visitRequest   VisitRequest?     @relation(fields: [visitRequestId], references: [id])
  visitId        String?           @db.Uuid
  visit          VisitAppointment? @relation(fields: [visitId], references: [id])
  leadId         String?           @db.Uuid
  lead           Lead?             @relation(fields: [leadId], references: [id])
  clientId       String?           @db.Uuid
  client         User?             @relation("VisitActivityClient", fields: [clientId], references: [id])
  actorId        String?           @db.Uuid
  actor          User?             @relation("VisitActivityActor", fields: [actorId], references: [id])
  actorRole      String?
  type           VisitActivityType
  oldValue       Json?
  newValue       Json?
  note           String?
  createdAt      DateTime          @default(now())

  @@index([visitRequestId])
  @@index([visitId])
  @@index([leadId])
  @@index([clientId])
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?  @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unitId    String?  @db.Uuid
  unit      Unit?    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, projectId, unitId])
  @@index([userId])
}

// =============================================================================
// RESERVATIONS / CONTRACTS / INSTALLMENTS / DEPOSITS
// =============================================================================

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  CONVERTED
}

enum ReservationBookingPaymentStatus {
  UNPAID
  PENDING
  PAID
  WAIVED
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
}

enum DepositType {
  BOOKING_AMOUNT
  DOWN_PAYMENT
  INSTALLMENT
  FINAL_PAYMENT
}

model Reservation {
  id                String            @id @default(uuid()) @db.Uuid
  reservationNumber String?           @unique
  unitId            String            @db.Uuid
  unit              Unit              @relation(fields: [unitId], references: [id])
  salesId           String            @db.Uuid
  sales             User              @relation("ReservationSales", fields: [salesId], references: [id])
  leadId            String?           @db.Uuid
  lead              Lead?             @relation(fields: [leadId], references: [id])
  clientId          String?           @db.Uuid
  client            User?             @relation("ReservationClient", fields: [clientId], references: [id])
  status            ReservationStatus @default(PENDING)
  notes             String?
  reason            String?
  expiresAt         DateTime
  approvedAt        DateTime?
  rejectedAt        DateTime?
  cancelledAt       DateTime?
  convertedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // ── Booking amount tracking (manual, recorded by Admin) ──────────────────
  bookingAmount             Decimal                         @default(0) @db.Decimal(14, 2)
  bookingPaymentStatus      ReservationBookingPaymentStatus @default(UNPAID)
  bookingPaidAt             DateTime?
  bookingNotes              String?
  installmentPlanTemplateId String?                         @db.Uuid
  installmentPlanTemplate   InstallmentPlanTemplate?        @relation("ReservationPlanTemplate", fields: [installmentPlanTemplateId], references: [id])

  // ── Selected duration + financial snapshot (set at create time, immutable) ──
  selectedDurationOptionId   String?                       @db.Uuid
  selectedDurationOption     InstallmentPlanDurationOption? @relation(fields: [selectedDurationOptionId], references: [id], onDelete: SetNull)
  selectedDurationMonths     Int?
  selectedIncreasePercentage Decimal?                      @db.Decimal(6, 2)
  snapshotDownPaymentAmount   Decimal?                      @db.Decimal(14, 2)
  snapshotRemainingAmount     Decimal?                      @db.Decimal(14, 2)
  snapshotFinancedAmount      Decimal?                      @db.Decimal(14, 2)
  snapshotMonthlyInstallment  Decimal?                      @db.Decimal(14, 2)
  snapshotTotalPayable        Decimal?                      @db.Decimal(14, 2)
  snapshotFinalPaymentAmount  Decimal?                      @db.Decimal(14, 2)

  // ── Broker attribution (additive, all nullable; salesId stays required) ──
  brokerId               String?  @db.Uuid
  broker                 Broker?  @relation(fields: [brokerId], references: [id])
  brokerAgentId          String?  @db.Uuid
  brokerAgent            User?    @relation("ReservationBrokerAgent", fields: [brokerAgentId], references: [id])
  commissionLockedPct    Decimal? @db.Decimal(5, 2)
  commissionLockedAmount Decimal? @db.Decimal(14, 2)

  reservationNotes ReservationNote[]
  activities       ReservationActivity[]
  contract         Contract?
  deposits         Deposit[]
  brokerCommissions BrokerCommission[]

  @@index([unitId])
  @@index([salesId])
  @@index([clientId])
  @@index([status])
  @@index([installmentPlanTemplateId])
  @@index([selectedDurationOptionId])
  @@index([brokerId])
  @@index([brokerAgentId])
}

enum ReservationActivityType {
  CREATED
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  NOTE_ADDED
  BOOKING_PAYMENT_CONFIRMED
  BOOKING_PAYMENT_UNCONFIRMED
  CONVERTED
}

model ReservationNote {
  id            String      @id @default(uuid()) @db.Uuid
  reservationId String      @db.Uuid
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  body          String
  authorId      String?     @db.Uuid
  author        User?       @relation("ReservationNoteAuthor", fields: [authorId], references: [id])
  createdAt     DateTime    @default(now())

  @@index([reservationId])
}

model ReservationActivity {
  id            String                  @id @default(uuid()) @db.Uuid
  reservationId String                  @db.Uuid
  reservation   Reservation             @relation(fields: [reservationId], references: [id])
  type          ReservationActivityType
  actorId       String?                 @db.Uuid
  actor         User?                   @relation("ReservationActivityActor", fields: [actorId], references: [id])
  note          String?
  createdAt     DateTime                @default(now())

  @@index([reservationId])
}

model Contract {
  id             String       @id @default(uuid()) @db.Uuid
  contractNumber String?      @unique
  customerId     String       @db.Uuid
  customer       User         @relation("ContractCustomer", fields: [customerId], references: [id])
  unitId         String       @db.Uuid
  unit           Unit         @relation(fields: [unitId], references: [id])
  reservationId  String?      @unique @db.Uuid
  reservation    Reservation? @relation(fields: [reservationId], references: [id])
  pdfUrl         String?
  signedAt       DateTime?
  totalAmount    Decimal      @db.Decimal(14, 2)
  downPayment    Decimal      @default(0) @db.Decimal(14, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // ── Broker attribution (additive, all nullable) ─────────────────────────
  brokerId      String? @db.Uuid
  broker        Broker? @relation(fields: [brokerId], references: [id])
  brokerAgentId String? @db.Uuid
  brokerAgent   User?   @relation("ContractBrokerAgent", fields: [brokerAgentId], references: [id])

  installmentPlan InstallmentPlan?
  deposits        Deposit[]
  brokerCommission BrokerCommission?

  @@index([customerId])
  @@index([unitId])
  @@index([reservationId])
  @@index([brokerId])
  @@index([brokerAgentId])
}

model InstallmentPlan {
  id            String               @id @default(uuid()) @db.Uuid
  contractId    String               @unique @db.Uuid
  contract      Contract             @relation(fields: [contractId], references: [id], onDelete: Cascade)
  totalMonths   Int
  monthlyAmount Decimal              @db.Decimal(14, 2)
  startsAt      DateTime
  frequency     InstallmentFrequency @default(MONTHLY)
  createdAt     DateTime             @default(now())

  installments Installment[]
}

model Installment {
  id        String            @id @default(uuid()) @db.Uuid
  planId    String            @db.Uuid
  plan      InstallmentPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  type      PlanPaymentType   @default(INSTALLMENT)
  dueDate   DateTime
  amount    Decimal           @db.Decimal(14, 2)
  status    InstallmentStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime          @default(now())

  deposits Deposit[]

  @@index([planId, dueDate])
  @@index([status])
}

model Deposit {
  id             String       @id @default(uuid()) @db.Uuid
  type           DepositType  @default(INSTALLMENT)
  contractId     String?      @db.Uuid
  contract       Contract?    @relation(fields: [contractId], references: [id])
  reservationId  String?      @db.Uuid
  reservation    Reservation? @relation(fields: [reservationId], references: [id])
  installmentId  String?      @db.Uuid
  installment    Installment? @relation(fields: [installmentId], references: [id])
  amount         Decimal      @db.Decimal(14, 2)
  paidAt         DateTime
  receiptUrl     String?
  recordedById   String       @db.Uuid
  recordedBy     User         @relation("DepositRecordedBy", fields: [recordedById], references: [id])
  verified       Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([contractId])
  @@index([reservationId])
}

// =============================================================================
// INSTALLMENT PLAN TEMPLATES (standalone, Admin-created, visible to Sales)
// =============================================================================

enum DownPaymentType {
  FIXED
  PERCENTAGE
}

enum InstallmentFrequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  YEARLY
}

enum StartDateRule {
  MANUAL
  AFTER_RESERVATION
  AFTER_CONTRACT
}

enum PlanTemplateStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum PlanPaymentType {
  RESERVATION
  DOWN_PAYMENT
  INSTALLMENT
  FINAL_PAYMENT
}

model InstallmentPlanTemplate {
  id                 String               @id @default(uuid()) @db.Uuid
  name               String
  description        String?
  projectId          String               @db.Uuid
  project            Project              @relation("ProjectPlanTemplates", fields: [projectId], references: [id])
  unitId             String?              @db.Uuid
  unit               Unit?                @relation("UnitPlanTemplates", fields: [unitId], references: [id])
  totalPrice         Decimal              @db.Decimal(14, 2)
  discountAmount     Decimal              @default(0) @db.Decimal(14, 2)
  netPrice           Decimal              @db.Decimal(14, 2)
  reservationAmount  Decimal              @default(0) @db.Decimal(14, 2)
  downPaymentType    DownPaymentType      @default(FIXED)
  downPaymentValue   Decimal              @db.Decimal(14, 2)
  downPaymentAmount  Decimal              @db.Decimal(14, 2)
  installmentsCount  Int?
  frequency          InstallmentFrequency @default(MONTHLY)
  startDateRule      StartDateRule        @default(AFTER_CONTRACT)
  manualStartDate    DateTime?
  finalPaymentAmount Decimal?             @db.Decimal(14, 2)
  visibility         String               @default("SALES_ONLY")
  status             PlanTemplateStatus   @default(DRAFT)
  createdById        String               @db.Uuid
  createdBy          User                 @relation("PlanTemplateCreator", fields: [createdById], references: [id])
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  scheduleItems   PlanTemplateScheduleItem[]
  durationOptions InstallmentPlanDurationOption[]
  reservations    Reservation[]                  @relation("ReservationPlanTemplate")

  @@index([projectId])
  @@index([status])
}

model InstallmentPlanDurationOption {
  id                 String                  @id @default(uuid()) @db.Uuid
  planId             String                  @db.Uuid
  plan               InstallmentPlanTemplate @relation(fields: [planId], references: [id], onDelete: Cascade)
  durationMonths     Int
  increasePercentage Decimal                 @default(0) @db.Decimal(6, 2)
  order              Int                     @default(0)
  createdAt          DateTime                @default(now())

  reservations Reservation[]

  @@unique([planId, durationMonths])
  @@index([planId])
}

model PlanTemplateScheduleItem {
  id               String                  @id @default(uuid()) @db.Uuid
  planId           String                  @db.Uuid
  plan             InstallmentPlanTemplate @relation(fields: [planId], references: [id], onDelete: Cascade)
  paymentNumber    Int
  paymentType      PlanPaymentType
  dueDate          DateTime?
  amount           Decimal                 @db.Decimal(14, 2)
  remainingBalance Decimal                 @db.Decimal(14, 2)

  @@index([planId])
}

// =============================================================================
// BONUS / TARGETS
// =============================================================================

enum BonusEntryStatus {
  PENDING
  APPROVED
  PAID
}

model BonusRule {
  id         String       @id @default(uuid()) @db.Uuid
  name       String
  percentage Decimal      @default(0) @db.Decimal(5, 2)
  conditions Json         @default("{}") // e.g. { minUnits: 3 }
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  entries    BonusEntry[]
}

model BonusEntry {
  id        String           @id @default(uuid()) @db.Uuid
  salesId   String           @db.Uuid
  sales     User             @relation(fields: [salesId], references: [id])
  ruleId    String           @db.Uuid
  rule      BonusRule        @relation(fields: [ruleId], references: [id])
  amount    Decimal          @db.Decimal(14, 2)
  period    String // "2026-05"
  status    BonusEntryStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([salesId, period])
  @@index([status])
}

model SalesTarget {
  id           String   @id @default(uuid()) @db.Uuid
  salesId      String   @db.Uuid
  sales        User     @relation(fields: [salesId], references: [id])
  period       String // "2026-05"
  amountTarget Decimal  @db.Decimal(14, 2)
  unitsTarget  Int
  createdAt    DateTime @default(now())

  @@unique([salesId, period])
}

// =============================================================================
// MAINTENANCE
// =============================================================================

enum MaintenanceStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model MaintenanceCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      Json // Translatable
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  requests MaintenanceRequest[]
}

model MaintenanceRequest {
  id              String              @id @default(uuid()) @db.Uuid
  customerId      String              @db.Uuid
  customer        User                @relation("MaintenanceCustomer", fields: [customerId], references: [id])
  unitId          String              @db.Uuid
  unit            Unit                @relation(fields: [unitId], references: [id])
  categoryId      String              @db.Uuid
  category        MaintenanceCategory @relation(fields: [categoryId], references: [id])
  description     String
  status          MaintenanceStatus   @default(OPEN)
  assignedAdminId String?             @db.Uuid
  assignedAdmin   User?               @relation("MaintenanceAdmin", fields: [assignedAdminId], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([customerId])
  @@index([status])
}

// =============================================================================
// CMS / NOTIFICATIONS / AUDIT
// =============================================================================

model CmsPage {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  title     Json // Translatable
  body      Json // Translatable
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Banner {
  id        String   @id @default(uuid()) @db.Uuid
  imageUrl  String
  title     Json // Translatable
  link      String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Article {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  title     Json
  excerpt   Json
  body      Json
  coverUrl  String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum NotificationChannel {
  PUSH
  EMAIL
  IN_APP
}

model NotificationTemplate {
  id        String              @id @default(uuid()) @db.Uuid
  code      String              @unique // "visit_approved", "deposit_recorded"
  channel   NotificationChannel
  subject   Json // Translatable
  body      Json // Translatable (supports {{var}} placeholders)
  active    Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model Notification {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @db.Uuid
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateCode String
  payload      Json                @default("{}")
  channel      NotificationChannel
  sentAt       DateTime?
  readAt       DateTime?
  createdAt    DateTime            @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String // CREATE | UPDATE | DELETE | LOGIN | etc.
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

// =============================================================================
// BROKERS (Phase 1 — foundation only; no commissions/payouts yet)
// =============================================================================

enum BrokerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum BrokerUserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum BrokerCommissionModel {
  PERCENT_OF_SALE
  FIXED_PER_UNIT
  TIERED
}

enum BrokerLeadStatus {
  PENDING
  APPROVED
  REJECTED
  DUPLICATE
  EXPIRED
}

enum BrokerCommissionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum BrokerPayoutStatus {
  DRAFT
  APPROVED
  PROCESSING
  PAID
  CANCELLED
}

enum BrokerPayoutMethod {
  BANK_TRANSFER
  CHEQUE
  CASH
  OTHER
}

enum BrokerActivityType {
  PAYOUT_CREATED
  PAYOUT_APPROVED
  PAYOUT_PROCESSING
  PAYOUT_PAID
  PAYOUT_CANCELLED
}

model Broker {
  id                     String                @id @default(uuid()) @db.Uuid
  companyName            String
  commercialName         String?
  code                   String                @unique
  logoUrl                String?
  email                  String?
  phone                  String?
  address                String?
  city                   String?
  taxId                  String?               @unique
  commercialRegistration String?
  bankName               String?
  bankAccountName        String?
  bankIban               String?
  defaultCommissionPct   Decimal               @default(0) @db.Decimal(5, 2)
  commissionModel        BrokerCommissionModel @default(PERCENT_OF_SALE)
  status                 BrokerStatus          @default(PENDING)
  contractStartAt        DateTime?
  contractEndAt          DateTime?
  contractPdfUrl         String?
  notes                  String?
  createdById            String?               @db.Uuid
  createdBy              User?                 @relation("BrokerCreatedBy", fields: [createdById], references: [id])
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  brokerUsers       BrokerUser[]
  projectAccess     BrokerProjectAccess[]
  unitAccess        BrokerUnitAccess[]
  leads             Lead[]
  reservations      Reservation[]
  contracts         Contract[]
  visitRequests     VisitRequest[]
  visitAppointments VisitAppointment[]
  commissions       BrokerCommission[]
  payouts           BrokerPayout[]
  activityLogs      BrokerActivityLog[]

  @@index([status])
  @@index([code])
}

model BrokerUser {
  id                    String           @id @default(uuid()) @db.Uuid
  userId                String           @unique @db.Uuid
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerId              String           @db.Uuid
  broker                Broker           @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  jobTitle              String?
  isPrimaryContact      Boolean          @default(false)
  canManageBrokerUsers  Boolean          @default(false)
  canViewCommissions    Boolean          @default(true)
  invitedAt             DateTime?
  joinedAt              DateTime?
  status                BrokerUserStatus @default(INVITED)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([brokerId, status])
}

model BrokerProjectAccess {
  id                 String   @id @default(uuid()) @db.Uuid
  brokerId           String   @db.Uuid
  broker             Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  projectId          String   @db.Uuid
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  commissionPct      Decimal? @db.Decimal(5, 2)
  fixedAmountPerUnit Decimal? @db.Decimal(14, 2)
  startsAt           DateTime?
  endsAt             DateTime?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())

  @@unique([brokerId, projectId])
  @@index([projectId, active])
}

model BrokerUnitAccess {
  id        String   @id @default(uuid()) @db.Uuid
  brokerId  String   @db.Uuid
  broker    Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  unitId    String   @db.Uuid
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([brokerId, unitId])
  @@index([unitId, active])
}

model BrokerCommission {
  id                String                 @id @default(uuid()) @db.Uuid
  commissionNumber  String                 @unique
  brokerId          String                 @db.Uuid
  broker            Broker                 @relation(fields: [brokerId], references: [id])
  brokerAgentId     String?                @db.Uuid
  brokerAgent       User?                  @relation("BrokerCommissionAgent", fields: [brokerAgentId], references: [id])
  contractId        String                 @unique @db.Uuid
  contract          Contract               @relation(fields: [contractId], references: [id])
  reservationId     String?                @db.Uuid
  reservation       Reservation?           @relation(fields: [reservationId], references: [id])
  unitId            String                 @db.Uuid
  unit              Unit                   @relation(fields: [unitId], references: [id])
  projectId         String                 @db.Uuid
  project           Project                @relation(fields: [projectId], references: [id])

  basisAmount       Decimal                @db.Decimal(14, 2)
  commissionPct     Decimal?               @db.Decimal(5, 2)
  grossAmount       Decimal                @db.Decimal(14, 2)
  taxPct            Decimal                @default(0) @db.Decimal(5, 2)
  taxAmount         Decimal                @default(0) @db.Decimal(14, 2)
  withholdingPct    Decimal                @default(0) @db.Decimal(5, 2)
  withholdingAmount Decimal                @default(0) @db.Decimal(14, 2)
  netAmount         Decimal                @db.Decimal(14, 2)

  status            BrokerCommissionStatus @default(PENDING)
  earnedAt          DateTime

  approvedById      String?                @db.Uuid
  approvedBy        User?                  @relation("BrokerCommissionApprovedBy", fields: [approvedById], references: [id])
  approvedAt        DateTime?
  rejectedById      String?                @db.Uuid
  rejectedBy        User?                  @relation("BrokerCommissionRejectedBy", fields: [rejectedById], references: [id])
  rejectedAt        DateTime?
  rejectionReason   String?

  notes             String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  // ── Payout link (nullable; set when admin attaches the commission to a
  //    DRAFT BrokerPayout) ──────────────────────────────────────────────────
  payoutId          String?                @db.Uuid
  payout            BrokerPayout?          @relation(fields: [payoutId], references: [id])

  @@index([brokerId, status])
  @@index([projectId, earnedAt])
  @@index([brokerAgentId])
  @@index([status, earnedAt])
  @@index([payoutId])
}

model BrokerPayout {
  id                String              @id @default(uuid()) @db.Uuid
  payoutNumber      String              @unique
  brokerId          String              @db.Uuid
  broker            Broker              @relation(fields: [brokerId], references: [id])
  period            String?             // "2026-05" style, optional

  totalGross        Decimal             @default(0) @db.Decimal(14, 2)
  totalTax          Decimal             @default(0) @db.Decimal(14, 2)
  totalWithholding  Decimal             @default(0) @db.Decimal(14, 2)
  totalNet          Decimal             @default(0) @db.Decimal(14, 2)

  status            BrokerPayoutStatus  @default(DRAFT)
  paymentMethod     BrokerPayoutMethod?
  paymentReference  String?
  receiptUrl        String?
  invoiceUrl        String?
  scheduledAt       DateTime?

  approvedById      String?             @db.Uuid
  approvedBy        User?               @relation("BrokerPayoutApprovedBy", fields: [approvedById], references: [id])
  approvedAt        DateTime?
  processedById     String?             @db.Uuid
  processedBy       User?               @relation("BrokerPayoutProcessedBy", fields: [processedById], references: [id])
  processedAt       DateTime?
  paidAt            DateTime?
  cancelledById     String?             @db.Uuid
  cancelledBy       User?               @relation("BrokerPayoutCancelledBy", fields: [cancelledById], references: [id])
  cancelledAt       DateTime?
  cancelReason      String?

  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  commissions       BrokerCommission[]

  @@index([brokerId, status])
  @@index([brokerId, period])
  @@index([status, createdAt])
}

model BrokerActivityLog {
  id            String             @id @default(uuid()) @db.Uuid
  brokerId      String             @db.Uuid
  broker        Broker             @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  brokerAgentId String?            @db.Uuid
  brokerAgent   User?              @relation("BrokerActivityLogAgent", fields: [brokerAgentId], references: [id])
  type          BrokerActivityType
  entityType    String
  entityId      String?            @db.Uuid
  payload       Json               @default("{}")
  createdAt     DateTime           @default(now())

  @@index([brokerId, createdAt])
  @@index([brokerAgentId, createdAt])
}

// =============================================================================
// SETTINGS (key-value)
// =============================================================================

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
