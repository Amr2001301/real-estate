// Real Estate Platform — Prisma schema
// Translatable fields are stored as Json: { ar: string, en: string }

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// TENANT / COMPANY
// =============================================================================

model Company {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  slug          String   @unique            // URL-safe identifier, used for subdomain routing
  logoUrl       String?
  country       String?                     // ISO 3166-1 alpha-2 (SA, AE, EG …)
  currency      String   @default("SAR")    // ISO 4217
  defaultLocale Locale   @default(ar)
  timezone      String   @default("Asia/Riyadh") // IANA tz database name
  isActive             Boolean            @default(true)
  subscriptionPlan     SubscriptionPlan   @default(TRIAL)
  subscriptionStatus   SubscriptionStatus @default(TRIAL)
  subscriptionStartAt  DateTime?
  subscriptionEndAt    DateTime?
  maxUsers             Int?
  cancelledAt          DateTime?
  cancelReason         String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // ── Relations ──────────────────────────────────────────────────────────────
  users                    User[]
  projects                 Project[]
  phases                   Phase[]
  buildings                Building[]
  units                    Unit[]
  unitStatusHistories      UnitStatusHistory[]
  unitMaintenanceItems     UnitMaintenanceItem[]
  leadSources              LeadSource[]
  leads                    Lead[]
  leadNotes                LeadNote[]
  leadActivities           LeadActivity[]
  infoRequests             InfoRequest[]
  visitRequests            VisitRequest[]
  visitAppointments        VisitAppointment[]
  visitActivities          VisitActivity[]
  reservations             Reservation[]
  reservationNotes         ReservationNote[]
  reservationActivities    ReservationActivity[]
  contracts                Contract[]
  installmentPlans         InstallmentPlan[]
  installments             Installment[]
  deposits                 Deposit[]
  installmentPlanTemplates InstallmentPlanTemplate[]
  bonusRules               BonusRule[]
  bonusEntries             BonusEntry[]
  salesTargets             SalesTarget[]
  maintenanceCategories    MaintenanceCategory[]
  maintenanceRequests      MaintenanceRequest[]
  maintenanceRequestItems  MaintenanceRequestItem[]
  cmsPages                 CmsPage[]
  banners                  Banner[]
  articles                 Article[]
  notificationTemplates    NotificationTemplate[]
  notifications            Notification[]
  auditLogs                AuditLog[]
  brokers                  Broker[]
  brokerUsers              BrokerUser[]
  brokerProjectAccesses    BrokerProjectAccess[]
  brokerUnitAccesses       BrokerUnitAccess[]
  brokerCommissions        BrokerCommission[]
  brokerPayouts            BrokerPayout[]
  brokerActivityLogs       BrokerActivityLog[]
  settings                 Setting[]
  documents                Document[]
  chatSessions             ChatSession[]
  chatMessages             ChatMessage[]
  chatFeedback             ChatFeedback[]
  pricingPackages          PricingPackage[]

  // Module flags — controls which dashboard sections are visible for this company
  modules                  Json?           // { broker, website, maintenance, reports, leads, visits, contracts, installments, deposits }

  @@index([slug])
  @@index([isActive])
}

// =============================================================================
// PRICING
// =============================================================================

model PricingPackage {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String?  @db.Uuid                        // null = global template
  company      Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  planTier     String                                   // TRIAL | STARTER | PROFESSIONAL | ENTERPRISE | CUSTOM
  nameAr       String
  nameEn       String
  descAr       String?
  descEn       String?
  currency     String   @default("SAR")
  monthlyPrice Decimal? @db.Decimal(12, 2)
  annualPrice  Decimal? @db.Decimal(12, 2)
  setupFee     Decimal? @db.Decimal(12, 2)
  maxUsers     Int?
  highlights   Json     @default("[]")                 // string[]  — key bullet points
  specialOffer Json?                                   // { titleAr, titleEn, discountPct, validUntil } | null
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
  @@index([planTier])
}

// =============================================================================
// AUTH & USERS
// =============================================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SALES
  CLIENT
  CUSTOMER
  BROKER
  SALES_MANAGER
  MAINTENANCE_SUPERVISOR
}

enum SubscriptionPlan {
  TRIAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  CANCELLING
  CANCELLED
  EXPIRED
  SUSPENDED
}

enum Locale {
  ar
  en
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  role              UserRole
  email             String?   @unique
  phone             String?   @unique
  passwordHash      String?
  fullName          String
  locale            Locale    @default(ar)
  active            Boolean   @default(true)
  avatarUrl         String?
  emailVerifiedAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?

  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  rolePermissions         UserPermission[]
  deviceTokens            DeviceToken[]
  notifications           Notification[]
  favorites               Favorite[]
  visitRequests           VisitRequest[]            @relation("VisitRequestUser")
  infoRequests            InfoRequest[]             @relation("InfoRequestUser")
  assignedLeads           Lead[]                    @relation("LeadAssignedSales")
  leads                   Lead[]                    @relation("LeadClient")
  leadNotes               LeadNote[]
  reservations            Reservation[]             @relation("ReservationSales")
  reservationClients      Reservation[]             @relation("ReservationClient")
  reservationNotes        ReservationNote[]         @relation("ReservationNoteAuthor")
  reservationActivities   ReservationActivity[]     @relation("ReservationActivityActor")
  customerContracts       Contract[]                @relation("ContractCustomer")
  bonusEntries            BonusEntry[]
  salesTargets            SalesTarget[]
  maintenanceReqs         MaintenanceRequest[]      @relation("MaintenanceCustomer")
  maintenanceAssigned     MaintenanceRequest[]      @relation("MaintenanceAdmin")
  recordedDeposits        Deposit[]                 @relation("DepositRecordedBy")
  reviewedDeposits        Deposit[]                 @relation("DepositReviewedBy")
  auditLogs               AuditLog[]
  unitStatusChanges       UnitStatusHistory[]
  visitsScheduledForSales VisitRequest[]            @relation("VisitRequestSales")
  assignedAppointments    VisitAppointment[]        @relation("AppointmentSales")
  createdAppointments     VisitAppointment[]        @relation("AppointmentCreator")
  updatedAppointments     VisitAppointment[]        @relation("AppointmentUpdater")
  clientAppointments      VisitAppointment[]        @relation("AppointmentClient")
  actedVisitActivities    VisitActivity[]           @relation("VisitActivityActor")
  clientVisitActivities   VisitActivity[]           @relation("VisitActivityClient")
  planTemplatesCreated    InstallmentPlanTemplate[] @relation("PlanTemplateCreator")

  // ── Broker relations (additive) ──────────────────────────────────────────
  brokerProfile           BrokerUser?
  brokersOnboarded        Broker[]                  @relation("BrokerCreatedBy")
  brokerLeads             Lead[]                    @relation("LeadBrokerAgent")
  brokerReservations      Reservation[]             @relation("ReservationBrokerAgent")
  brokerContracts         Contract[]                @relation("ContractBrokerAgent")
  brokerVisitRequests     VisitRequest[]            @relation("VisitRequestBrokerAgent")
  brokerAppointments      VisitAppointment[]        @relation("AppointmentBrokerAgent")
  brokerCommissionsAsAgent    BrokerCommission[]    @relation("BrokerCommissionAgent")
  brokerCommissionsApproved   BrokerCommission[]    @relation("BrokerCommissionApprovedBy")
  brokerCommissionsRejected   BrokerCommission[]    @relation("BrokerCommissionRejectedBy")
  brokerPayoutsApproved       BrokerPayout[]        @relation("BrokerPayoutApprovedBy")
  brokerPayoutsProcessed      BrokerPayout[]        @relation("BrokerPayoutProcessedBy")
  brokerPayoutsCancelled      BrokerPayout[]        @relation("BrokerPayoutCancelledBy")
  brokerActivityLogs          BrokerActivityLog[]   @relation("BrokerActivityLogAgent")
  uploadedDocuments           Document[]            @relation("DocumentUploader")

  // ── Tenant scoping ───────────────────────────────────────────────────────
  // Nullable so existing users and platform-level ADMIN users without a
  // company assignment are unaffected. Assigned by MT-Seed-01 for all
  // current users; required for new users via the registration flow.
  companyId    String?  @db.Uuid
  company      Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // ── Sales team scoping (additive) ────────────────────────────────────────
  // A SALES user may be assigned to a SALES_MANAGER via managerId. Nullable so
  // existing users are unaffected; self-relation, no cascade.
  managerId    String? @db.Uuid
  manager      User?   @relation("SalesTeam", fields: [managerId], references: [id], onDelete: SetNull)
  teamMembers  User[]  @relation("SalesTeam")

  @@index([role])
  @@index([phone])
  @@index([email])
  @@index([managerId])
  @@index([companyId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  deviceId  String?
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 hash of the raw token — raw token is ONLY sent in the email link.
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model OtpCode {
  id        String   @id @default(uuid()) @db.Uuid
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, consumed])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique // e.g. "projects:create"
  description String?
  users       UserPermission[]
}

model UserPermission {
  userId       String     @db.Uuid
  permissionId String     @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String // "ios" | "android" | "web"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// =============================================================================
// PROJECTS, PHASES, BUILDINGS, UNITS
// =============================================================================

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum UnitStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum MediaType {
  IMAGE
  VIDEO
  FLOORPLAN
  DOCUMENT
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  name        Json // Translatable { ar, en }
  description Json
  city        String
  lat         Float
  lng         Float
  status      ProjectStatus @default(DRAFT)
  featured    Boolean       @default(false)
  services    Json          @default("[]") // Translatable[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  media         ProjectMedia[]
  phases        Phase[]
  leads         Lead[]
  visitRequests VisitRequest[]
  infoRequests  InfoRequest[]
  favorites     Favorite[]
  appointments  VisitAppointment[]
  planTemplates InstallmentPlanTemplate[] @relation("ProjectPlanTemplates")
  brokerAccess  BrokerProjectAccess[]
  brokerCommissions BrokerCommission[]

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([city])
  @@index([status, featured])
  @@index([companyId])
}

model ProjectMedia {
  id        String    @id @default(uuid()) @db.Uuid
  projectId String    @db.Uuid
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  type      MediaType @default(IMAGE)
  order     Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([projectId, order])
}

model Phase {
  id        String     @id @default(uuid()) @db.Uuid
  projectId String     @db.Uuid
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      Json // Translatable
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  buildings Building[]

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([companyId])
}

model Building {
  id          String   @id @default(uuid()) @db.Uuid
  phaseId     String   @db.Uuid
  phase       Phase    @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  name        String
  totalFloors Int      @default(1)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  units       Unit[]

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([phaseId])
  @@index([companyId])
}

model Unit {
  id                   String     @id @default(uuid()) @db.Uuid
  buildingId           String     @db.Uuid
  building             Building   @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  code                 String
  type                 String // studio | 1BR | 2BR | villa | ...
  area                 Float
  bedrooms             Int        @default(0)
  bathrooms            Int        @default(0)
  floor                Int        @default(0)
  price                Decimal    @db.Decimal(14, 2)
  status               UnitStatus @default(AVAILABLE)
  reservationExpiresAt DateTime?
  latitude             Float?
  longitude            Float?
  address              String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  media               UnitMedia[]
  history             UnitStatusHistory[]
  reservations        Reservation[]
  contracts           Contract[]
  visitRequests       VisitRequest[]
  infoRequests        InfoRequest[]
  favorites           Favorite[]
  maintenanceRequests MaintenanceRequest[]
  maintenanceItems    UnitMaintenanceItem[]
  appointments        VisitAppointment[]
  leadsInterested     Lead[]                    @relation("LeadUnitInterest")
  planTemplates       InstallmentPlanTemplate[] @relation("UnitPlanTemplates")
  brokerAccess        BrokerUnitAccess[]
  brokerCommissions   BrokerCommission[]

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([buildingId, code])
  @@index([status])
  @@index([price])
  @@index([companyId])
}

model UnitMedia {
  id        String    @id @default(uuid()) @db.Uuid
  unitId    String    @db.Uuid
  unit      Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  url       String
  type      MediaType @default(IMAGE)
  order     Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([unitId, order])
}

model UnitStatusHistory {
  id          String     @id @default(uuid()) @db.Uuid
  unitId      String     @db.Uuid
  unit        Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  oldStatus   UnitStatus
  newStatus   UnitStatus
  changedById String?    @db.Uuid
  changedBy   User?      @relation(fields: [changedById], references: [id])
  reason      String?
  changedAt   DateTime   @default(now())

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([unitId, changedAt])
  @@index([companyId])
}

// =============================================================================
// CRM
// =============================================================================

enum LeadStage {
  NEW
  INTERESTED
  VISIT
  NEGOTIATION
  WON
  LOST
}

model LeadSource {
  id        String   @id @default(uuid()) @db.Uuid
  name      Json // Translatable
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  leads     Lead[]

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
}

model Lead {
  id                String      @id @default(uuid()) @db.Uuid
  // Canonical contact lives on the linked Client (User). The denormalized
  // fullName/phone/email below are kept for safe backfill and as a cache for
  // legacy readers; new code should prefer `client.*`.
  clientId          String      @db.Uuid
  client            User        @relation("LeadClient", fields: [clientId], references: [id])
  fullName          String
  phone             String
  email             String?
  sourceId          String?     @db.Uuid
  source            LeadSource? @relation(fields: [sourceId], references: [id])
  projectInterestId String?     @db.Uuid
  projectInterest   Project?    @relation(fields: [projectInterestId], references: [id])
  unitInterestId    String?     @db.Uuid
  unitInterest      Unit?       @relation("LeadUnitInterest", fields: [unitInterestId], references: [id])
  assignedSalesId   String?     @db.Uuid
  assignedSales     User?       @relation("LeadAssignedSales", fields: [assignedSalesId], references: [id])
  stage             LeadStage   @default(NEW)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // ── Ad / UTM attribution (first-touch, all nullable) ───────────────────
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  fbclid       String?

  // ── Broker attribution (additive, all nullable) ─────────────────────────
  brokerId              String?            @db.Uuid
  broker                Broker?            @relation(fields: [brokerId], references: [id])
  brokerAgentId         String?            @db.Uuid
  brokerAgent           User?              @relation("LeadBrokerAgent", fields: [brokerAgentId], references: [id])
  brokerSubmittedAt     DateTime?
  brokerApprovalStatus  BrokerLeadStatus?
  brokerApprovedAt      DateTime?
  brokerRejectedAt      DateTime?
  brokerRejectionReason String?

  notes           LeadNote[]
  activities      LeadActivity[]
  reservations    Reservation[]
  visitRequests   VisitRequest[]
  infoRequests    InfoRequest[]
  appointments    VisitAppointment[]
  visitActivities VisitActivity[]

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([assignedSalesId])
  @@index([stage])
  @@index([phone])
  @@index([unitInterestId])
  @@index([brokerId])
  @@index([brokerAgentId])
  @@index([brokerApprovalStatus])
  @@index([companyId])
}

model LeadNote {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @db.Uuid
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  salesId   String   @db.Uuid
  sales     User     @relation(fields: [salesId], references: [id])
  body      String
  createdAt DateTime @default(now())

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([companyId])
}

model LeadActivity {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @db.Uuid
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      LeadActivityType
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([companyId])
}

// =============================================================================
// REQUESTS / VISITS / FAVORITES
// =============================================================================

enum LeadActivityType {
  created
  assigned
  status_change
  visit
  reservation
  relinked_away
  relinked_from
  broker_submitted
  broker_approved
  broker_rejected
  broker_marked_duplicate
  broker_note
  broker_visit_requested
  broker_submitted_via_visit
  broker_reservation_created
  broker_contract_created
  broker_contract_signed
  broker_commission_earned
  broker_commission_approved
  broker_commission_rejected
  broker_commission_cancelled
}

enum InfoRequestStatus {
  OPEN
  RESPONDED
  CLOSED
}

enum VisitStatus {
  PENDING
  APPROVED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum VisitRequestStatus {
  NEW
  UNDER_REVIEW
  CONVERTED
  REJECTED
  CANCELLED
}

enum VisitRequestSource {
  WEBSITE
  MOBILE_APP
  SALES
  PHONE
  WHATSAPP
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  // Customer asked to reschedule the proposed datetime. Admin must propose a
  // new one (PENDING_RESCHEDULE → SCHEDULED) before the visit can proceed.
  PENDING_RESCHEDULE
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum VisitActivityType {
  REQUEST_CREATED
  REQUEST_REVIEWED
  REQUEST_REJECTED
  REQUEST_CANCELLED
  VISIT_SCHEDULED
  VISIT_CONFIRMED
  VISIT_COMPLETED
  VISIT_CANCELLED
  VISIT_NO_SHOW
  VISIT_RESCHEDULED
  SALES_ASSIGNED
  NOTE_ADDED
  // Two-sided confirmation workflow (P2).
  CUSTOMER_CONFIRMED
  CUSTOMER_RESCHEDULE_REQUESTED
  REMINDER_SENT
  SALES_REASSIGNED
}

model InfoRequest {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation("InfoRequestUser", fields: [userId], references: [id])
  leadId    String?  @db.Uuid
  lead      Lead?    @relation(fields: [leadId], references: [id])
  projectId String?  @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id])
  unitId    String?  @db.Uuid
  unit      Unit?    @relation(fields: [unitId], references: [id])
  message   String
  status    InfoRequestStatus @default(OPEN)
  createdAt DateTime @default(now())

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([userId])
  @@index([companyId])
}

model VisitRequest {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String?     @db.Uuid
  user            User?       @relation("VisitRequestUser", fields: [userId], references: [id])
  leadId          String?     @db.Uuid
  lead            Lead?       @relation(fields: [leadId], references: [id])
  projectId       String      @db.Uuid
  project         Project     @relation(fields: [projectId], references: [id])
  unitId          String?     @db.Uuid
  unit            Unit?       @relation(fields: [unitId], references: [id])
  preferredDate   DateTime
  scheduledAt     DateTime?
  status          VisitStatus @default(PENDING)
  assignedSalesId String?     @db.Uuid
  assignedSales   User?       @relation("VisitRequestSales", fields: [assignedSalesId], references: [id])
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // v2 fields — additive, all nullable, coexist with legacy columns above
  requestNumber          String?             @unique
  customerName           String?
  customerPhone          String?
  customerEmail          String?
  preferredTime          String?
  preferredContactMethod String?
  source                 VisitRequestSource?
  requestNotes           String?
  adminNotes             String?
  requestStatus          VisitRequestStatus?
  convertedAt            DateTime?
  rejectedAt             DateTime?
  cancelledAt            DateTime?

  // ── Broker attribution (additive, all nullable) ─────────────────────────
  brokerId      String? @db.Uuid
  broker        Broker? @relation(fields: [brokerId], references: [id])
  brokerAgentId String? @db.Uuid
  brokerAgent   User?   @relation("VisitRequestBrokerAgent", fields: [brokerAgentId], references: [id])

  appointments    VisitAppointment[]
  visitActivities VisitActivity[]

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([requestStatus])
  @@index([projectId])
  @@index([assignedSalesId])
  @@index([brokerId])
  @@index([brokerAgentId])
  @@index([companyId])
}

model VisitAppointment {
  id                 String            @id @default(uuid()) @db.Uuid
  visitNumber        String            @unique
  visitRequestId     String?           @db.Uuid
  visitRequest       VisitRequest?     @relation(fields: [visitRequestId], references: [id])
  leadId             String?           @db.Uuid
  lead               Lead?             @relation(fields: [leadId], references: [id])
  clientId           String?           @db.Uuid
  client             User?             @relation("AppointmentClient", fields: [clientId], references: [id])
  projectId          String?           @db.Uuid
  project            Project?          @relation(fields: [projectId], references: [id])
  unitId             String?           @db.Uuid
  unit               Unit?             @relation(fields: [unitId], references: [id])
  assignedSalesId    String?           @db.Uuid
  assignedSales      User?             @relation("AppointmentSales", fields: [assignedSalesId], references: [id])
  scheduledAt        DateTime
  durationMinutes    Int?
  location           String?
  meetingPoint       String?
  status             AppointmentStatus @default(SCHEDULED)
  salesNotes         String?
  customerFeedback   String?
  resultNotes        String?
  cancellationReason String?
  noShowReason       String?

  // ── Gap 7 — post-visit feedback/ratings. Dedicated columns; do NOT reuse the
  // legacy free-text fields above (customerFeedback doubles as the reschedule
  // reason). customer* = customer-submitted, sales* = staff-submitted. rating
  // is 1–5; the submittedAt timestamps double as the "already submitted" guard.
  customerRating            Int?
  customerRatingText        String?
  customerRatingSubmittedAt DateTime?
  salesRating               Int?
  salesRatingText           String?
  salesRatingSubmittedAt    DateTime?

  createdById        String?           @db.Uuid
  createdBy          User?             @relation("AppointmentCreator", fields: [createdById], references: [id])
  updatedById        String?           @db.Uuid
  updatedBy          User?             @relation("AppointmentUpdater", fields: [updatedById], references: [id])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  confirmedAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  noShowAt           DateTime?

  // ── Reminder sentinel timestamps (null = not yet sent) ─────────────────
  dayBeforeReminderSentAt  DateTime?
  hourBeforeReminderSentAt DateTime?

  // ── Broker attribution (additive, all nullable) ─────────────────────────
  brokerId      String? @db.Uuid
  broker        Broker? @relation(fields: [brokerId], references: [id])
  brokerAgentId String? @db.Uuid
  brokerAgent   User?   @relation("AppointmentBrokerAgent", fields: [brokerAgentId], references: [id])

  visitActivities VisitActivity[]

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([scheduledAt])
  @@index([visitRequestId])
  @@index([assignedSalesId])
  @@index([leadId])
  @@index([clientId])
  @@index([brokerId])
  @@index([brokerAgentId])
  @@index([companyId])
}

model VisitActivity {
  id             String            @id @default(uuid()) @db.Uuid
  visitRequestId String?           @db.Uuid
  visitRequest   VisitRequest?     @relation(fields: [visitRequestId], references: [id])
  visitId        String?           @db.Uuid
  visit          VisitAppointment? @relation(fields: [visitId], references: [id])
  leadId         String?           @db.Uuid
  lead           Lead?             @relation(fields: [leadId], references: [id])
  clientId       String?           @db.Uuid
  client         User?             @relation("VisitActivityClient", fields: [clientId], references: [id])
  actorId        String?           @db.Uuid
