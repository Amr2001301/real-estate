  @@unique([userId, projectId, unitId])
  @@index([userId])
}

// =============================================================================
// RESERVATIONS / CONTRACTS / INSTALLMENTS / DEPOSITS
// =============================================================================

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  CONVERTED
}

enum ReservationBookingPaymentStatus {
  UNPAID
  PENDING
  PAID
  WAIVED
}

/// P8 — how the admin chose the booking amount at create time. FIXED is the
/// legacy default (admin enters an absolute amount, or the linked plan's
/// reservationAmount is copied). PERCENTAGE is new: admin enters a percent
/// and the server computes `unit.price × percent / 100` at create time.
/// Stored for audit; bookingAmount remains the source of truth at runtime.
enum ReservationBookingAmountMode {
  FIXED
  PERCENTAGE
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
}

enum DepositType {
  BOOKING_AMOUNT
  DOWN_PAYMENT
  INSTALLMENT
  FINAL_PAYMENT
}

model Reservation {
  id                String            @id @default(uuid()) @db.Uuid
  reservationNumber String?           @unique
  unitId            String            @db.Uuid
  unit              Unit              @relation(fields: [unitId], references: [id])
  salesId           String            @db.Uuid
  sales             User              @relation("ReservationSales", fields: [salesId], references: [id])
  leadId            String?           @db.Uuid
  lead              Lead?             @relation(fields: [leadId], references: [id])
  clientId          String?           @db.Uuid
  client            User?             @relation("ReservationClient", fields: [clientId], references: [id])
  status            ReservationStatus @default(PENDING)
  notes             String?
  reason            String?
  expiresAt         DateTime
  approvedAt        DateTime?
  rejectedAt        DateTime?
  cancelledAt       DateTime?
  convertedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // ── Booking amount tracking (manual, recorded by Admin) ──────────────────
  bookingAmount             Decimal                         @default(0) @db.Decimal(14, 2)
  bookingPaymentStatus      ReservationBookingPaymentStatus @default(UNPAID)
  bookingPaidAt             DateTime?
  bookingNotes              String?
  // P8 — booking amount mode + percentage audit trail. FIXED is the historical
  // default (also covers plan-driven creates). PERCENTAGE records the percent
  // the admin entered AND the unit price snapshot at create time so the math
  // can be re-derived later if the unit's price changes.
  bookingAmountMode           ReservationBookingAmountMode @default(FIXED)
  bookingAmountPercent        Decimal?                     @db.Decimal(5, 2)
  bookingAmountUnitPriceSnapshot Decimal?                  @db.Decimal(14, 2)
  installmentPlanTemplateId String?                         @db.Uuid
  installmentPlanTemplate   InstallmentPlanTemplate?        @relation("ReservationPlanTemplate", fields: [installmentPlanTemplateId], references: [id])

  // ── Selected duration + financial snapshot (set at create time, immutable) ──
  selectedDurationOptionId   String?                       @db.Uuid
  selectedDurationOption     InstallmentPlanDurationOption? @relation(fields: [selectedDurationOptionId], references: [id], onDelete: SetNull)
  selectedDurationMonths     Int?
  selectedIncreasePercentage Decimal?                      @db.Decimal(6, 2)
  snapshotDownPaymentAmount   Decimal?                      @db.Decimal(14, 2)
  snapshotRemainingAmount     Decimal?                      @db.Decimal(14, 2)
  snapshotFinancedAmount      Decimal?                      @db.Decimal(14, 2)
  snapshotMonthlyInstallment  Decimal?                      @db.Decimal(14, 2)
  snapshotTotalPayable        Decimal?                      @db.Decimal(14, 2)
  snapshotFinalPaymentAmount  Decimal?                      @db.Decimal(14, 2)

  // ── Broker attribution (additive, all nullable; salesId stays required) ──
  brokerId               String?  @db.Uuid
  broker                 Broker?  @relation(fields: [brokerId], references: [id])
  brokerAgentId          String?  @db.Uuid
  brokerAgent            User?    @relation("ReservationBrokerAgent", fields: [brokerAgentId], references: [id])
  commissionLockedPct    Decimal? @db.Decimal(5, 2)
  commissionLockedAmount Decimal? @db.Decimal(14, 2)

  reservationNotes ReservationNote[]
  activities       ReservationActivity[]
  contract         Contract?
  deposits         Deposit[]
  brokerCommissions BrokerCommission[]

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([unitId])
  @@index([salesId])
  @@index([clientId])
  @@index([status])
  @@index([installmentPlanTemplateId])
  @@index([selectedDurationOptionId])
  @@index([brokerId])
  @@index([brokerAgentId])
  @@index([companyId])
}

enum ReservationActivityType {
  CREATED
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  NOTE_ADDED
  BOOKING_PAYMENT_CONFIRMED
  BOOKING_PAYMENT_UNCONFIRMED
  CONVERTED
}

model ReservationNote {
  id            String      @id @default(uuid()) @db.Uuid
  reservationId String      @db.Uuid
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  body          String
  authorId      String?     @db.Uuid
  author        User?       @relation("ReservationNoteAuthor", fields: [authorId], references: [id])
  createdAt     DateTime    @default(now())

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([reservationId])
  @@index([companyId])
}

model ReservationActivity {
  id            String                  @id @default(uuid()) @db.Uuid
  reservationId String                  @db.Uuid
  reservation   Reservation             @relation(fields: [reservationId], references: [id])
  type          ReservationActivityType
  actorId       String?                 @db.Uuid
  actor         User?                   @relation("ReservationActivityActor", fields: [actorId], references: [id])
  note          String?
  createdAt     DateTime                @default(now())

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([reservationId])
  @@index([companyId])
}

model Contract {
  id             String       @id @default(uuid()) @db.Uuid
  contractNumber String?      @unique
  customerId     String       @db.Uuid
  customer       User         @relation("ContractCustomer", fields: [customerId], references: [id])
  unitId         String       @db.Uuid
  unit           Unit         @relation(fields: [unitId], references: [id])
  reservationId  String?      @unique @db.Uuid
  reservation    Reservation? @relation(fields: [reservationId], references: [id])
  pdfUrl         String?
  signedAt       DateTime?
  totalAmount    Decimal      @db.Decimal(14, 2)
  downPayment    Decimal      @default(0) @db.Decimal(14, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // ── Broker attribution (additive, all nullable) ─────────────────────────
  brokerId      String? @db.Uuid
  broker        Broker? @relation(fields: [brokerId], references: [id])
  brokerAgentId String? @db.Uuid
  brokerAgent   User?   @relation("ContractBrokerAgent", fields: [brokerAgentId], references: [id])

  installmentPlan InstallmentPlan?
  deposits        Deposit[]
  brokerCommission BrokerCommission?
  // At most one auto-generated sales commission entry (Batch B wires creation).
  bonusEntry      BonusEntry?

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([unitId])
  @@index([reservationId])
  @@index([brokerId])
  @@index([brokerAgentId])
  @@index([companyId])
}

model InstallmentPlan {
  id            String               @id @default(uuid()) @db.Uuid
  contractId    String               @unique @db.Uuid
  contract      Contract             @relation(fields: [contractId], references: [id], onDelete: Cascade)
  totalMonths   Int
  monthlyAmount Decimal              @db.Decimal(14, 2)
  startsAt      DateTime
  frequency     InstallmentFrequency @default(MONTHLY)
  createdAt     DateTime             @default(now())

  installments Installment[]

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
}

model Installment {
  id        String            @id @default(uuid()) @db.Uuid
  planId    String            @db.Uuid
  plan      InstallmentPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  type      PlanPaymentType   @default(INSTALLMENT)
  dueDate   DateTime
  amount    Decimal           @db.Decimal(14, 2)
  status    InstallmentStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime          @default(now())

  deposits Deposit[]

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([planId, dueDate])
  @@index([status])
  @@index([companyId])
}

/// P11 — Manual/offline payment-proof review state. NO_PROOF is the default
/// when a deposit is created admin-side (legacy verify flow). Customer-side
/// submission goes directly into PENDING_REVIEW. APPROVED + REJECTED are the
/// admin terminal states; REJECTED carries `rejectionReason` and the customer
/// may resubmit freely (resubmit resets the row to PENDING_REVIEW).
enum DepositReviewStatus {
  NO_PROOF
  PENDING_REVIEW
  APPROVED
  REJECTED
}

/// P11 — Manual/offline payment method recorded by the customer when
/// submitting proof. No online payment / card data ever stored.
enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  OTHER
}

model Deposit {
  id             String       @id @default(uuid()) @db.Uuid
  type           DepositType  @default(INSTALLMENT)
  contractId     String?      @db.Uuid
  contract       Contract?    @relation(fields: [contractId], references: [id])
  reservationId  String?      @db.Uuid
  reservation    Reservation? @relation(fields: [reservationId], references: [id])
  installmentId  String?      @db.Uuid
  installment    Installment? @relation(fields: [installmentId], references: [id])
  amount         Decimal      @db.Decimal(14, 2)
  paidAt         DateTime
  receiptUrl     String?
  recordedById   String       @db.Uuid
  recordedBy     User         @relation("DepositRecordedBy", fields: [recordedById], references: [id])
  /// LEGACY (P11) — kept for back-compat. New code reads/writes via
  /// reviewStatus; this stays in lockstep (true iff reviewStatus = APPROVED).
  verified       Boolean      @default(false)
  createdAt      DateTime     @default(now())

  // ── P11 — payment-proof review ────────────────────────────────────────
  reviewStatus     DepositReviewStatus @default(NO_PROOF)
  rejectionReason  String?             @db.VarChar(2000)
  reviewedAt       DateTime?
  reviewedById     String?             @db.Uuid
  reviewedBy       User?               @relation("DepositReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  proofDocumentId  String?             @db.Uuid
  proofDocument    Document?           @relation("DepositProofDocument", fields: [proofDocumentId], references: [id], onDelete: SetNull)
  paymentMethod    PaymentMethod?

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([contractId])
  @@index([reservationId])
  @@index([reviewStatus])
  @@index([reviewedById])
  @@index([proofDocumentId])
  @@index([companyId])
}

// =============================================================================
// INSTALLMENT PLAN TEMPLATES (standalone, Admin-created, visible to Sales)
// =============================================================================

enum DownPaymentType {
  FIXED
  PERCENTAGE
}

enum InstallmentFrequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  YEARLY
}

enum StartDateRule {
  MANUAL
  AFTER_RESERVATION
  AFTER_CONTRACT
}

enum PlanTemplateStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum PlanPaymentType {
  RESERVATION
  DOWN_PAYMENT
  INSTALLMENT
  FINAL_PAYMENT
}

model InstallmentPlanTemplate {
  id                 String               @id @default(uuid()) @db.Uuid
  name               String
  description        String?
  projectId          String               @db.Uuid
  project            Project              @relation("ProjectPlanTemplates", fields: [projectId], references: [id])
  unitId             String?              @db.Uuid
  unit               Unit?                @relation("UnitPlanTemplates", fields: [unitId], references: [id])
  totalPrice         Decimal              @db.Decimal(14, 2)
  // Discount off the total price. `discountAmount` is the COMPUTED amount
  // (netPrice = totalPrice − discountAmount). The type/value pair mirrors the
  // down-payment pattern: FIXED → value is the amount; PERCENTAGE → value is a
  // percent of totalPrice (the template's pricing base).
  discountAmount     Decimal              @default(0) @db.Decimal(14, 2)
  discountType       DownPaymentType      @default(FIXED)
  discountValue      Decimal              @default(0) @db.Decimal(14, 2)
  netPrice           Decimal              @db.Decimal(14, 2)
  // Booking/reservation amount. `reservationAmount` is the COMPUTED amount used
  // by the schedule (mirrors downPaymentAmount). The type/value pair mirrors the
  // down-payment pattern: FIXED → value is the amount; PERCENTAGE → value is the
  // percent (applied to the unit price at reservation time, to netPrice for the
  // template's own schedule preview).
  reservationAmount  Decimal              @default(0) @db.Decimal(14, 2)
  reservationAmountType  DownPaymentType  @default(FIXED)
  reservationAmountValue Decimal          @default(0) @db.Decimal(14, 2)
  downPaymentType    DownPaymentType      @default(FIXED)
  downPaymentValue   Decimal              @db.Decimal(14, 2)
  downPaymentAmount  Decimal              @db.Decimal(14, 2)
  installmentsCount  Int?
  frequency          InstallmentFrequency @default(MONTHLY)
  startDateRule      StartDateRule        @default(AFTER_CONTRACT)
  manualStartDate    DateTime?
  finalPaymentAmount Decimal?             @db.Decimal(14, 2)
  visibility         String               @default("SALES_ONLY")
  status             PlanTemplateStatus   @default(DRAFT)
  createdById        String               @db.Uuid
  createdBy          User                 @relation("PlanTemplateCreator", fields: [createdById], references: [id])
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  scheduleItems   PlanTemplateScheduleItem[]
  durationOptions InstallmentPlanDurationOption[]
  reservations    Reservation[]                  @relation("ReservationPlanTemplate")

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([status])
  @@index([companyId])
}

model InstallmentPlanDurationOption {
  id                 String                  @id @default(uuid()) @db.Uuid
  planId             String                  @db.Uuid
  plan               InstallmentPlanTemplate @relation(fields: [planId], references: [id], onDelete: Cascade)
  durationMonths     Int
  increasePercentage Decimal                 @default(0) @db.Decimal(6, 2)
  order              Int                     @default(0)
  createdAt          DateTime                @default(now())

  reservations Reservation[]

  @@unique([planId, durationMonths])
  @@index([planId])
}

model PlanTemplateScheduleItem {
  id               String                  @id @default(uuid()) @db.Uuid
  planId           String                  @db.Uuid
  plan             InstallmentPlanTemplate @relation(fields: [planId], references: [id], onDelete: Cascade)
  paymentNumber    Int
  paymentType      PlanPaymentType
  dueDate          DateTime?
  amount           Decimal                 @db.Decimal(14, 2)
  remainingBalance Decimal                 @db.Decimal(14, 2)

  @@index([planId])
}

// =============================================================================
// BONUS / TARGETS
// =============================================================================

enum BonusEntryStatus {
  PENDING
  APPROVED
  PAID
}

// How a BonusEntry was created. MANUAL = admin-entered (existing v1 workflow).
// CONTRACT_AUTO = generated from a signed contract (Batch B — not yet wired).
enum BonusEntrySource {
  MANUAL
  CONTRACT_AUTO
}

model BonusRule {
  id         String       @id @default(uuid()) @db.Uuid
  name       String
  percentage Decimal      @default(0) @db.Decimal(5, 2)
  conditions Json         @default("{}") // e.g. { minUnits: 3 }
  active     Boolean      @default(true)
  // Eligible for automatic sales-commission generation on contract signing.
  // Generation (Batch B) requires exactly one ACTIVE rule with this flag; zero
  // or multiple ⇒ skip. No generation happens from this flag alone in Batch A.
  autoApplyOnSignedContract Boolean @default(false)
  createdAt  DateTime     @default(now())
  entries    BonusEntry[]

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
}

model BonusEntry {
  id        String           @id @default(uuid()) @db.Uuid
  salesId   String           @db.Uuid
  sales     User             @relation(fields: [salesId], references: [id])
  ruleId    String           @db.Uuid
  rule      BonusRule        @relation(fields: [ruleId], references: [id])
  amount    Decimal          @db.Decimal(14, 2)
  period    String // "2026-05"
  status    BonusEntryStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime         @default(now())

  // ── Auto-commission provenance (additive; manual entries leave these null) ──
  // contractId is unique so at most one auto entry can exist per contract
  // (Postgres allows multiple NULLs, so manual entries are unaffected). The FK
  // is SET NULL on contract deletion to preserve the compensation record.
  source       BonusEntrySource @default(MANUAL)
  contractId   String?          @unique @db.Uuid
  contract     Contract?        @relation(fields: [contractId], references: [id], onDelete: SetNull)
  basisAmount  Decimal?         @db.Decimal(14, 2)
  commissionPct Decimal?        @db.Decimal(5, 2)

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([salesId, period])
  @@index([status])
  @@index([companyId])
}

model SalesTarget {
  id           String   @id @default(uuid()) @db.Uuid
  salesId      String   @db.Uuid
  sales        User     @relation(fields: [salesId], references: [id])
  period       String // "2026-05"
  amountTarget Decimal  @db.Decimal(14, 2)
  unitsTarget  Int
  createdAt    DateTime @default(now())

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([salesId, period])
  @@index([companyId])
}

// =============================================================================
// MAINTENANCE
// =============================================================================

enum MaintenanceStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Warranty verdict, snapshotted onto a MaintenanceRequest at creation (request
// integration lands in a later batch). On UnitMaintenanceItem it is computed
// for display only and never persisted.
enum WarrantyStatus {
  IN_WARRANTY
  OUT_OF_WARRANTY
  UNKNOWN
}

// Admin review gate for a maintenance request. The SLA timer (dueAt) only
// starts once a request is APPROVED. Existing rows default to APPROVED.
enum MaintenanceReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// Who has confirmed a maintenance request's resolution. BOTH once the customer
// AND the assigned supervisor have each confirmed.
enum MaintenanceResolutionConfirmedBy {
  CUSTOMER
  SUPERVISOR
  BOTH
}

model MaintenanceCategory {
  id        String              @id @default(uuid()) @db.Uuid
  // Normalized slug for duplicate prevention (e.g. "plumbing"). Nullable so
  // existing rows are unaffected; new rows always get a code (unique).
  code      String?             @unique
  name      Json // Translatable
  active    Boolean             @default(true)
  priority  MaintenancePriority @default(MEDIUM)
  // Handling SLA: target resolution window in minutes (admin enters hours/days;
  // stored as minutes). Nullable — a category may have no SLA.
  slaDurationMinutes Int?
  // Warranty duration in months (admin enters months/years; stored as months).
  // Used to compute a unit item's warrantyEnd when a contract is signed.
  warrantyDurationMonths Int?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt @default(now())

  requests MaintenanceRequest[]
  maintenanceItems UnitMaintenanceItem[]
  requestItems MaintenanceRequestItem[]

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
}

// A maintainable component of a unit (AC, plumbing, doors, ...) with an
// optional warranty window and supplier/contractor attribution. Items hang off
// the unit (not Unit.type). Soft-deactivated via `active`; never hard-deleted.
model UnitMaintenanceItem {
  id             String               @id @default(uuid()) @db.Uuid
  unitId         String               @db.Uuid
  unit           Unit                 @relation(fields: [unitId], references: [id], onDelete: Cascade)
  categoryId     String?              @db.Uuid
  category       MaintenanceCategory? @relation(fields: [categoryId], references: [id])
  name           Json // Translatable
  warrantyStart  DateTime?
  warrantyEnd    DateTime?
  // The category warranty duration (months) frozen at contract-signing time, so
  // later category edits never change an already-started warranty.
  warrantyDurationMonthsSnapshot Int?
  supplierName   String?
  contractorName String?
  notes          String?
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  requests     MaintenanceRequest[]
  requestItems MaintenanceRequestItem[]

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([unitId])
  @@index([categoryId])
  @@index([active])
  @@index([companyId])
}

model MaintenanceRequest {
  id              String              @id @default(uuid()) @db.Uuid
  customerId      String              @db.Uuid
  customer        User                @relation("MaintenanceCustomer", fields: [customerId], references: [id])
  unitId          String              @db.Uuid
  unit            Unit                @relation(fields: [unitId], references: [id])
  categoryId      String              @db.Uuid
  category        MaintenanceCategory @relation(fields: [categoryId], references: [id])
  description     String
  status          MaintenanceStatus   @default(OPEN)
  // Snapshot of the category's priority + computed due date at creation time,
  // so later category edits don't retroactively change existing requests.
  priority        MaintenancePriority?
  dueAt           DateTime?
  assignedAdminId String?             @db.Uuid
  assignedAdmin   User?               @relation("MaintenanceAdmin", fields: [assignedAdminId], references: [id])
  // Optional link to a maintainable item + warranty snapshot. All nullable;
  // populated when request↔item integration lands in a later batch.
  itemId              String?              @db.Uuid
  item                UnitMaintenanceItem? @relation(fields: [itemId], references: [id])
  warrantyStatus      WarrantyStatus?
  warrantyEndSnapshot DateTime?
  // Approval gate: the SLA timer (dueAt) only starts after APPROVED. Existing
  // rows default to APPROVED; customer-created requests start PENDING.
  reviewStatus                MaintenanceReviewStatus @default(APPROVED)
  approvedAt                  DateTime?
  rejectedAt                  DateTime?
  // Max handling SLA (minutes) across the request's selected categories,
  // snapshotted at approval; dueAt = approvedAt + this.
  maxHandlingSlaMinutesSnapshot Int?
  // Lifecycle timestamps (set as side effects of status transitions). These
  // represent the CURRENT lifecycle, not a historical audit — resolvedAt is
  // cleared on a RESOLVED→IN_PROGRESS reopen and re-set on the next RESOLVED.
  assignedAt        DateTime?
  firstInProgressAt DateTime?
  resolvedAt        DateTime?
  closedAt          DateTime?

  // ── Resolution loop (Phase A) — all additive/nullable ───────────────────
  // complaintAt: customer raised a complaint (only allowed once the request is
  // ≥24h overdue). unresolvedAt: durable "not solved" flag set by the cron a
  // further window after the complaint (no UNRESOLVED status enum value — the
  // timestamp is the flag). *ConfirmedResolutionAt: explicit two-sided sign-off.
  // resolvedBy: derived from the two confirmation timestamps. customerRating*:
  // the customer's 1–5 rating + optional note, mirrors the visit-feedback shape.
  complaintAt                     DateTime?
  unresolvedAt                    DateTime?
  customerConfirmedResolutionAt   DateTime?
  supervisorConfirmedResolutionAt DateTime?
  resolvedBy                      MaintenanceResolutionConfirmedBy?
  customerRating                  Int?
  customerRatingText              String?
  customerRatingSubmittedAt       DateTime?

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  items MaintenanceRequestItem[]

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([status])
  @@index([itemId])
  @@index([reviewStatus])
  @@index([resolvedAt])
  @@index([closedAt])
  @@index([complaintAt])
  @@index([unresolvedAt])
  @@index([companyId])
}

// One selected category/component on a maintenance request. Snapshots the
// category priority + handling SLA + the linked unit item's warranty at
// creation, so later category/item edits never change an existing request.
model MaintenanceRequestItem {
  id                       String              @id @default(uuid()) @db.Uuid
  requestId                String              @db.Uuid
  request                  MaintenanceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  itemId                   String?             @db.Uuid
  item                     UnitMaintenanceItem? @relation(fields: [itemId], references: [id])
  categoryId               String              @db.Uuid
  category                 MaintenanceCategory @relation(fields: [categoryId], references: [id])
  categoryPrioritySnapshot MaintenancePriority
  handlingSlaMinutesSnapshot Int?
  warrantyStatusSnapshot   WarrantyStatus      @default(UNKNOWN)
  warrantyEndSnapshot      DateTime?
  createdAt                DateTime            @default(now())

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([categoryId])
  @@index([itemId])
  @@index([companyId])
}

