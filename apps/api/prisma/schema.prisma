// =============================================================================
// BROKERS (Phase 1 — foundation only; no commissions/payouts yet)
// =============================================================================

enum BrokerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum BrokerUserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum BrokerCommissionModel {
  PERCENT_OF_SALE
  FIXED_PER_UNIT
  TIERED
}

enum BrokerLeadStatus {
  PENDING
  APPROVED
  REJECTED
  DUPLICATE
  EXPIRED
}

enum BrokerCommissionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum BrokerPayoutStatus {
  DRAFT
  APPROVED
  PROCESSING
  PAID
  CANCELLED
}

enum BrokerPayoutMethod {
  BANK_TRANSFER
  CHEQUE
  CASH
  OTHER
}

enum BrokerActivityType {
  PAYOUT_CREATED
  PAYOUT_APPROVED
  PAYOUT_PROCESSING
  PAYOUT_PAID
  PAYOUT_CANCELLED
}

model Broker {
  id                     String                @id @default(uuid()) @db.Uuid
  companyName            String
  commercialName         String?
  code                   String                @unique
  logoUrl                String?
  email                  String?
  phone                  String?
  address                String?
  city                   String?
  taxId                  String?               @unique
  commercialRegistration String?
  bankName               String?
  bankAccountName        String?
  bankIban               String?
  defaultCommissionPct   Decimal               @default(0) @db.Decimal(5, 2)
  commissionModel        BrokerCommissionModel @default(PERCENT_OF_SALE)
  status                 BrokerStatus          @default(PENDING)
  contractStartAt        DateTime?
  contractEndAt          DateTime?
  contractPdfUrl         String?
  notes                  String?
  createdById            String?               @db.Uuid
  createdBy              User?                 @relation("BrokerCreatedBy", fields: [createdById], references: [id])
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  brokerUsers       BrokerUser[]
  projectAccess     BrokerProjectAccess[]
  unitAccess        BrokerUnitAccess[]
  leads             Lead[]
  reservations      Reservation[]
  contracts         Contract[]
  visitRequests     VisitRequest[]
  visitAppointments VisitAppointment[]
  commissions       BrokerCommission[]
  payouts           BrokerPayout[]
  activityLogs      BrokerActivityLog[]

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([code])
  @@index([companyId])
}

model BrokerUser {
  id                    String           @id @default(uuid()) @db.Uuid
  userId                String           @unique @db.Uuid
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerId              String           @db.Uuid
  broker                Broker           @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  jobTitle              String?
  isPrimaryContact      Boolean          @default(false)
  canManageBrokerUsers  Boolean          @default(false)
  canViewCommissions    Boolean          @default(true)
  invitedAt             DateTime?
  joinedAt              DateTime?
  status                BrokerUserStatus @default(INVITED)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([brokerId, status])
  @@index([companyId])
}

model BrokerProjectAccess {
  id                 String   @id @default(uuid()) @db.Uuid
  brokerId           String   @db.Uuid
  broker             Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  projectId          String   @db.Uuid
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  commissionPct      Decimal? @db.Decimal(5, 2)
  fixedAmountPerUnit Decimal? @db.Decimal(14, 2)
  startsAt           DateTime?
  endsAt             DateTime?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([brokerId, projectId])
  @@index([projectId, active])
  @@index([companyId])
}

model BrokerUnitAccess {
  id        String   @id @default(uuid()) @db.Uuid
  brokerId  String   @db.Uuid
  broker    Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  unitId    String   @db.Uuid
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([brokerId, unitId])
  @@index([unitId, active])
  @@index([companyId])
}

model BrokerCommission {
  id                String                 @id @default(uuid()) @db.Uuid
  commissionNumber  String                 @unique
  brokerId          String                 @db.Uuid
  broker            Broker                 @relation(fields: [brokerId], references: [id])
  brokerAgentId     String?                @db.Uuid
  brokerAgent       User?                  @relation("BrokerCommissionAgent", fields: [brokerAgentId], references: [id])
  contractId        String                 @unique @db.Uuid
  contract          Contract               @relation(fields: [contractId], references: [id])
  reservationId     String?                @db.Uuid
  reservation       Reservation?           @relation(fields: [reservationId], references: [id])
  unitId            String                 @db.Uuid
  unit              Unit                   @relation(fields: [unitId], references: [id])
  projectId         String                 @db.Uuid
  project           Project                @relation(fields: [projectId], references: [id])

  basisAmount       Decimal                @db.Decimal(14, 2)
  commissionPct     Decimal?               @db.Decimal(5, 2)
  grossAmount       Decimal                @db.Decimal(14, 2)
  taxPct            Decimal                @default(0) @db.Decimal(5, 2)
  taxAmount         Decimal                @default(0) @db.Decimal(14, 2)
  withholdingPct    Decimal                @default(0) @db.Decimal(5, 2)
  withholdingAmount Decimal                @default(0) @db.Decimal(14, 2)
  netAmount         Decimal                @db.Decimal(14, 2)

  status            BrokerCommissionStatus @default(PENDING)
  earnedAt          DateTime

  approvedById      String?                @db.Uuid
  approvedBy        User?                  @relation("BrokerCommissionApprovedBy", fields: [approvedById], references: [id])
  approvedAt        DateTime?
  rejectedById      String?                @db.Uuid
  rejectedBy        User?                  @relation("BrokerCommissionRejectedBy", fields: [rejectedById], references: [id])
  rejectedAt        DateTime?
  rejectionReason   String?

  notes             String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  // ── Payout link (nullable; set when admin attaches the commission to a
  //    DRAFT BrokerPayout) ──────────────────────────────────────────────────
  payoutId          String?                @db.Uuid
  payout            BrokerPayout?          @relation(fields: [payoutId], references: [id])

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([brokerId, status])
  @@index([projectId, earnedAt])
  @@index([brokerAgentId])
  @@index([status, earnedAt])
  @@index([payoutId])
  @@index([companyId])
}

model BrokerPayout {
  id                String              @id @default(uuid()) @db.Uuid
  payoutNumber      String              @unique
  brokerId          String              @db.Uuid
  broker            Broker              @relation(fields: [brokerId], references: [id])
  period            String?             // "2026-05" style, optional

  totalGross        Decimal             @default(0) @db.Decimal(14, 2)
  totalTax          Decimal             @default(0) @db.Decimal(14, 2)
  totalWithholding  Decimal             @default(0) @db.Decimal(14, 2)
  totalNet          Decimal             @default(0) @db.Decimal(14, 2)

  status            BrokerPayoutStatus  @default(DRAFT)
  paymentMethod     BrokerPayoutMethod?
  paymentReference  String?
  receiptUrl        String?
  invoiceUrl        String?
  scheduledAt       DateTime?

  approvedById      String?             @db.Uuid
  approvedBy        User?               @relation("BrokerPayoutApprovedBy", fields: [approvedById], references: [id])
  approvedAt        DateTime?
  processedById     String?             @db.Uuid
  processedBy       User?               @relation("BrokerPayoutProcessedBy", fields: [processedById], references: [id])
  processedAt       DateTime?
  paidAt            DateTime?
  cancelledById     String?             @db.Uuid
  cancelledBy       User?               @relation("BrokerPayoutCancelledBy", fields: [cancelledById], references: [id])
  cancelledAt       DateTime?
  cancelReason      String?

  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  commissions       BrokerCommission[]

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([brokerId, status])
  @@index([brokerId, period])
  @@index([status, createdAt])
  @@index([companyId])
}

model BrokerActivityLog {
  id            String             @id @default(uuid()) @db.Uuid
  brokerId      String             @db.Uuid
  broker        Broker             @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  brokerAgentId String?            @db.Uuid
  brokerAgent   User?              @relation("BrokerActivityLogAgent", fields: [brokerAgentId], references: [id])
  type          BrokerActivityType
  entityType    String
  entityId      String?            @db.Uuid
  payload       Json               @default("{}")
  createdAt     DateTime           @default(now())

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([brokerId, createdAt])
  @@index([brokerAgentId, createdAt])
  @@index([companyId])
}

// =============================================================================
// SETTINGS (key-value)
// =============================================================================

// NOTE: Setting uses key as PK for backward-compat. Full per-company
// key scoping (compound PK) is deferred to MT-Schema-04 with a data migration.
model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
}

// =============================================================================
// DOCUMENTS CENTER (Phase 17 — additive; existing media/url fields untouched)
// =============================================================================
//
// Generic, polymorphic document store. We deliberately store `ownerId` as a
// plain UUID String (no Prisma relation) because the owner can be any of
// several entities — Project, Unit, Lead, Reservation, Contract, Deposit,
// Broker, BrokerCommission, BrokerPayout, User. The application layer
// validates that the referenced entity exists when feasible; the DB does
// not enforce it.

enum DocumentOwnerType {
  PROJECT
  UNIT
  LEAD
  RESERVATION
  CONTRACT
  DEPOSIT
  BROKER
  BROKER_COMMISSION
  BROKER_PAYOUT
  USER
  MAINTENANCE_REQUEST
  OTHER
}

enum DocumentCategory {
  IMAGE
  CONTRACT
  RECEIPT
  INVOICE
  BROKER_AGREEMENT
  COMMISSION_STATEMENT
  PAYOUT_RECEIPT
  ID_DOCUMENT
  LEGAL
  FINANCIAL
  OTHER
}

enum DocumentVisibility {
  ADMIN_ONLY
  BROKER_VISIBLE
  CUSTOMER_VISIBLE
}

model Document {
  id           String             @id @default(uuid()) @db.Uuid
  ownerType    DocumentOwnerType
  ownerId      String             @db.Uuid
  category     DocumentCategory   @default(OTHER)
  title        String
  description  String?
  fileUrl      String
  fileName     String?
  mimeType     String?
  sizeBytes    Int?
  visibility   DocumentVisibility @default(ADMIN_ONLY)
  uploadedById String?            @db.Uuid
  uploadedBy   User?              @relation("DocumentUploader", fields: [uploadedById], references: [id])
  /// P11 — back-relation for Deposit.proofDocumentId. A single Document can
  /// be the canonical proof for at most one Deposit; the FK lives on Deposit.
  depositProofs Deposit[]         @relation("DepositProofDocument")
  deletedAt    DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([ownerType, ownerId])
  @@index([category])
  @@index([uploadedById])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([companyId])
}


// ─────────────────────────────────────────────────────────────────────────
// AI Chat (public assistant). v1 is public-only; userId/leadId are reserved
// (plain columns, no relations yet) for a future authenticated assistant and
// conversion linking. Transcripts are low-sensitivity (catalog Q&A + consented
// lead data captured in later chunks). Retention: ~90 days (purge cron later).
// ─────────────────────────────────────────────────────────────────────────
enum ChatSource {
  WEB
  MOBILE
}

enum ChatRole {
  USER
  ASSISTANT
  TOOL
  SYSTEM
}

enum ChatStatus {
  ACTIVE
  CLOSED
}

enum ChatFeedbackRating {
  UP
  DOWN
}

model ChatSession {
  id            String     @id @default(uuid()) @db.Uuid
  source        ChatSource @default(WEB)
  locale        Locale     @default(ar)
  anonymousId   String
  // Reserved for the future authenticated assistant; no relation in v1.
  userId        String?    @db.Uuid
  status        ChatStatus @default(ACTIVE)
  // Reserved for conversion linking (info/visit request → Lead); no relation in v1.
  leadId        String?    @db.Uuid
  metadata      Json?
  lastMessageAt DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  messages ChatMessage[]
  feedback ChatFeedback[]

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([anonymousId])
  @@index([lastMessageAt])
  @@index([companyId])
}

model ChatMessage {
  id         String      @id @default(uuid()) @db.Uuid
  sessionId  String      @db.Uuid
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role       ChatRole
  content    String
  // Populated in later chunks when tool-calling lands; trimmed summaries only.
  toolCalls  Json?
  toolResult Json?
  tokensIn   Int?
  tokensOut  Int?
  createdAt  DateTime    @default(now())

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@index([companyId])
}

model ChatFeedback {
  id        String             @id @default(uuid()) @db.Uuid
  sessionId String             @db.Uuid
  session   ChatSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messageId String?            @db.Uuid
  rating    ChatFeedbackRating
  comment   String?
  createdAt DateTime           @default(now())

  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([companyId])
}
