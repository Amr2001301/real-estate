# ─────────────────────────────────────────────────────────────────────────────
# API environment.
#
# Defaults here are safe for local development. The boot-time validator in
# src/config/env.validation.ts adds extra checks when NODE_ENV=production:
#
#   * JWT secrets must be at least 32 chars and not the placeholders below
#   * CORS_ORIGINS must list at least one origin
#   * R2_*  must all be set (uploads use Cloudflare R2 in production)
#   * SMTP_HOST / SMTP_USER / SMTP_PASSWORD / SMTP_FROM must all be set
#   * Twilio creds required only when OTP_PROVIDER=twilio
#   * SEED_ADMIN_PASSWORD must differ from the default ("ChangeMe123!")
#
# Firebase vars gate FCM push delivery (Phase 5). Leave empty to keep PUSH
# disabled (IN_APP works without them). When set, PushService fans out to all
# registered device tokens via sendEachForMulticast. The Admin Broadcast PUSH
# channel is blocked by BadRequestException unless all three are set.
# ─────────────────────────────────────────────────────────────────────────────

# --- Server ---
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/realestate?schema=public

# --- Redis (BullMQ + cache + throttler) ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
# Generate strong values with: openssl rand -base64 48
# Production rejects these placeholders.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# TFA1 — optional key that seals two-step sign-in secrets at rest. Unset, one is
# derived from JWT_REFRESH_SECRET (rotating that secret then turns everyone's
# two-step sign-in off). Set it once and keep it.
TOTP_ENCRYPTION_KEY=

# --- First platform owner (SUPER_ADMIN) ---
# On startup, when the platform has no SUPER_ADMIN yet, the API creates one
# with these credentials (password: 12+ characters). An existing SUPER_ADMIN
# is never changed, so they can stay set; remove them once you have signed in.
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NAME=

# --- OTP / SMS ---
OTP_PROVIDER=console # console | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Email (SMTP) ---
# Required in production.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM="Devora <devorasoftware@gmail.com>"

# --- Object storage (Cloudflare R2 in prod, MinIO locally) ---
# Two-bucket model:
#   R2_BUCKET         — public bucket for marketing media (projects, units, banners, avatars)
#                       Must have a CDN custom domain attached (R2_PUBLIC_URL).
#   R2_PRIVATE_BUCKET — private bucket for sensitive objects (contracts, receipts,
#                       documents, maintenance). Must NOT have a public CDN domain.
#                       Downloads go through short-lived presigned GET URLs only.
# Both buckets share the same R2 account credentials.
# R2_BUCKET and R2_PRIVATE_BUCKET MUST be different in production.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=real-estate-media
R2_PUBLIC_URL=https://media.example.com
R2_PRIVATE_BUCKET=real-estate-private

# --- Local S3-compatible endpoint (MinIO) ---
# When S3_ENDPOINT is set, the media service uses it instead of constructing
# the Cloudflare R2 endpoint from R2_ACCOUNT_ID. Leave UNSET in production.
# Path-style is required for MinIO and most local emulators (defaults on
# when S3_ENDPOINT is set and S3_FORCE_PATH_STYLE is unspecified).
# Local MinIO recipe (see docs/local-minio-storage.md for the full walk):
#   S3_ENDPOINT=http://localhost:9000
#   S3_REGION=us-east-1
#   S3_FORCE_PATH_STYLE=true
#   R2_ACCESS_KEY_ID=minioadmin
#   R2_SECRET_ACCESS_KEY=minioadmin
#   R2_BUCKET=real-estate-media         ← public bucket (anonymous download)
#   R2_PRIVATE_BUCKET=real-estate-private ← private bucket (no public access)
#   R2_PUBLIC_URL=http://localhost:9000/real-estate-media
S3_ENDPOINT=
S3_REGION=
S3_FORCE_PATH_STYLE=

# --- Firebase Admin SDK (FCM push delivery) ---
# Required for PUSH channel to work. Leave blank to keep PUSH disabled (safe).
# FIREBASE_PROJECT_ID: your Firebase project ID (e.g. myapp-12345)
# FIREBASE_CLIENT_EMAIL: service account email from Firebase console
# FIREBASE_PRIVATE_KEY: the private key string — escape newlines as \n in .env
#   e.g. FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Installment due-soon reminders (P11.7) ---
# Daily cron that DB-notifies customers of unpaid installments due soon.
# Unset: ON in production (NODE_ENV=production), OFF elsewhere. "false" turns
# it off in production; "true" turns it on anywhere.
# (The manual CLI `pnpm --filter api reminders:installments:due-soon` runs
#  regardless of this flag; the flag only gates the automatic cron.)
INSTALLMENT_REMINDERS_ENABLED=false
INSTALLMENT_REMINDER_DAYS_BEFORE=3
INSTALLMENT_REMINDER_CRON=0 9 * * *
# Optional IANA timezone for the cron (e.g. Africa/Cairo); defaults to server time.
INSTALLMENT_REMINDER_TIMEZONE=

# --- Follow-up reminders (FU2) ---
# 15 min before a lead's next action, an overdue
# alert 30 min after it, and a morning list at the company's local hour
# (default 9). On in production unless set to false; off elsewhere unless true.
# FOLLOW_UP_REMINDERS_ENABLED=
# FOLLOW_UP_DIGEST_HOUR=9

# --- Notification delivery retry (FG-09) ---
# Every 10 min, re-send push / e-mail that failed in the last 24 h (3 tries).
# Unset: ON in production, OFF elsewhere; "true" / "false" override.
NOTIFICATION_RETRY_ENABLED=false

# --- Chat session retention (90-day purge) ---
# Daily cron at 03:00 that hard-deletes anonymous chat sessions (+ messages/feedback)
# whose last message is older than 90 days.
# OFF by default — set to "true" to enable automatic purging.
CHAT_RETENTION_ENABLED=false
# Optional IANA timezone for the cron (e.g. Africa/Cairo); defaults to server time.
CHAT_RETENTION_TIMEZONE=

# --- Admin seed ---
# Production rejects this default password.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- Multi-tenancy ---
# UUID of the default company for @Public() routes (website catalog browsing).
# Run `pnpm --filter api prisma:seed` then query the Company table for the ID.
# Required in production — without it, all public listing endpoints will 500.
DEFAULT_COMPANY_ID=

# --- Observability (all optional) ---
# Sentry — if SENTRY_DSN is unset, the SDK is not loaded and the app boots
# normally. Leaving SENTRY_DSN blank is fully supported in dev and prod.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# 0 = errors-only (recommended start). Set 0.05–0.2 to sample traces.
SENTRY_TRACES_SAMPLE_RATE=0

# Logger: `json` for production (CloudWatch / Datadog / Loki), `pretty` for
# local dev. Leave unset to auto-pick (json in production, pretty elsewhere).
LOG_LEVEL=info
LOG_FORMAT=

# AI assistant (phase 6). Unset → the assistant answers 503 and no question is
# counted. AI_MODEL defaults to claude-opus-5-5; AI_EFFORT (low|medium|high|xhigh|max) to medium.
# ANTHROPIC_API_KEY=
# AI_MODEL=
# AI_EFFORT=
