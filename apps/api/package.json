{
  "name": "@rep/api",
  "version": "0.1.0",
  "private": true,
  "description": "Real Estate Platform — NestJS API",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:e2e": "tsx prisma/seed-e2e.ts",
    "prisma:studio": "prisma studio",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "smoke:broker": "tsx scripts/smoke-broker-module.ts",
    "dedupe:generic-leads:dry-run": "tsx scripts/dedupe-generic-leads.ts",
    "backfill:broker-commissions:dry-run": "tsx scripts/backfill-broker-commissions.ts",
    "contracts:backfill-documents:dry-run": "tsx scripts/backfill-contract-documents.ts",
    "contracts:backfill-documents": "tsx scripts/backfill-contract-documents.ts --execute",
    "reminders:installments:due-soon:dry-run": "tsx scripts/send-installment-due-soon-reminders.ts",
    "reminders:installments:due-soon": "tsx scripts/send-installment-due-soon-reminders.ts --execute",
    "cleanup:duplicate-seed-data:dry-run": "tsx scripts/cleanup-duplicate-seed-data.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^8.0.7",
    "@nestjs/throttler": "^6.3.0",
    "@aws-sdk/client-s3": "^3.706.0",
    "@aws-sdk/s3-request-presigner": "^3.706.0",
    "@prisma/client": "^5.22.0",
    "@rep/shared-types": "workspace:*",
    "@sentry/node": "^8.45.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "firebase-admin": "^13.0.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "nodemailer": "^6.9.16",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@rep/tsconfig": "workspace:*",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
