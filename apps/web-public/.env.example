# Base URL of the API (NestJS). The public site calls the API's `/v1` prefix.
#
# - Server-side (RSC/ISR): fetches `${API_BASE_URL}/v1/public/...` directly.
# - Browser: requests go to `/api-proxy/...`, which next.config.ts rewrites to
#   `${API_BASE_URL}/v1/...`.
#
# Optional locally — defaults to http://localhost:4000 when unset.
API_BASE_URL=http://localhost:4000

# Public site origin — used for canonical URLs, OpenGraph, sitemap, robots.
# Optional locally — defaults to http://localhost:3002 when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Optional: when set, mobile-app download buttons appear (else "قريبًا").
# NEXT_PUBLIC_APP_STORE_URL=
# NEXT_PUBLIC_GOOGLE_PLAY_URL=
# Optional: WhatsApp link on the contact page.
# NEXT_PUBLIC_WHATSAPP_URL=

# Optional: phone numbers for the Call / WhatsApp CTAs on project & unit detail.
# When unset, the matching button is hidden (no hardcoded production fallback).
# Use full international format, e.g. +9665XXXXXXXX.
# NEXT_PUBLIC_CONTACT_PHONE=
# NEXT_PUBLIC_WHATSAPP_PHONE=
