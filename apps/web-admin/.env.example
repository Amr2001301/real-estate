NEXT_PUBLIC_APP_NAME="Real Estate Admin"
API_BASE_URL=http://localhost:4000

# --- Google Maps (optional) ---
# Public browser key for the Google Maps JavaScript API. When unset, the
# project map falls back to a static placeholder with coordinates + an
# "open in Google Maps" external link. Restrict the key by HTTP referrer
# in Google Cloud Console — it ships to the browser.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Observability (all optional) ---
# Server-side Sentry. Initialised by src/instrumentation.ts only when set.
# Never exposed to the browser.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0

# Client-side Sentry. The NEXT_PUBLIC_ prefix means this value IS shipped to
# the browser — leave blank to disable client error reporting.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# --- Sentry source-map upload (optional, build-time) ---
# next.config.ts wraps the config with withSentryConfig ONLY when all three of
# SENTRY_AUTH_TOKEN + SENTRY_ORG + SENTRY_PROJECT are set. Without them the
# build is unchanged (no plugin, no upload, no failures). Uploaded source maps
# are deleted from the build output afterward so they are never served publicly.
#
# SENTRY_AUTH_TOKEN is a BUILD-TIME SECRET — never commit it and never expose it
# to the browser (it has no NEXT_PUBLIC_ prefix, so Next will not inline it).
# NEXT_PUBLIC_SENTRY_DSN above is the browser DSN and is safe to be public.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Optional explicit release name; if unset the SDK derives one from git.
SENTRY_RELEASE=

# --- E2E (Playwright; only needed when running `pnpm e2e`) ---
# See e2e/README.md. Defaults match the dev seed admin — override outside dev.
E2E_BASE_URL=http://localhost:3001
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=ChangeMe123!
# SALES + SALES_MANAGER smoke logins (defaults are the dev-seed demo users).
E2E_SALES_EMAIL=sales@example.com
E2E_SALES_PASSWORD=SalesPass123!
E2E_MANAGER_EMAIL=manager@example.com
E2E_MANAGER_PASSWORD=ManagerPass123!
# Set to 1 to disable Playwright's auto-started dev server (manage it yourself).
E2E_NO_WEBSERVER=
