<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Required for Flutter tooling (hot reload / breakpoints) and for
         reaching the dev API at http://10.0.2.2:4000 from the emulator. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Allow cleartext HTTP in debug builds only. Android 9+ blocks plain
         HTTP by default; the dev API runs on HTTP, not HTTPS. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
