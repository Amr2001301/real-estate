# Copy this file to .env (repo root) before running `docker compose up`.
# Values here are read by docker-compose.yml and forwarded to the API/web-admin
# containers. The API itself uses apps/api/.env.example as the source of truth
# for what each variable does — this file is only for the Docker stack.

# ─── Postgres (consumed by the `postgres` service) ────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=realestate
POSTGRES_PORT=5432

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ─── API ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3001

# REQUIRED — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-32+-char-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-32+-char-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

OTP_PROVIDER=console

# Set RUN_MIGRATIONS=true to apply pending Prisma migrations on API startup.
# Recommended for local; in production keep this `false` and run migrations
# manually via `pnpm --filter @rep/api prisma:deploy`.
RUN_MIGRATIONS=true

# Optional integrations — leave blank to disable.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# ─── Web admin ────────────────────────────────────────────────────────────────
WEB_ADMIN_PORT=3001
NEXT_PUBLIC_APP_NAME="Real Estate Admin"
